#!/usr/bin/env python3
"""tether: persistent Claude / Copilot sessions for herdr-app spaces.

  Inside a herdr terminal
    tether claude  [agent args...]   start or resume THIS terminal's Claude session
    tether copilot [agent args...]   start or resume THIS terminal's Copilot session
    tether                           resume whatever this terminal had (agent-agnostic);
                                     if it has none: a menu (start here / new space / open space)
    tether resume                    the same, without the menu (what `tether open` types into idle tabs)
    tether link claude|copilot [id]  link an existing session to this terminal (no id: the one you are in)
    tether status                    what is linked in this space
    tether reset [claude|copilot]    unlink this terminal (transcript is kept; id printed)

  Anywhere (also outside herdr)
    tether list [text] [--all]       spaces, with when you last used them (--all: also the
                                     `--resume <id>` command for every closed session)
    tether list --json               the same, machine-readable (used by the herdr spaces mod)
    tether touch <space-id>          record that a space was just switched to (sort order)
    tether open --id <space-id> [-y] open by exact id (no name matching, no menu)
    tether open [space] [-y]         resume every linked terminal of a space, by typing
                                     `tether resume` into the idle ones (asks first). A
                                     CLOSED space is recreated: a tab per linked terminal.
                                     No name: pick from a list.
    tether  (outside herdr)          menu: + new space, or open an existing space
    tether delete [space] [--close] [--sessions] [-y]
                                     delete a space: unlink it. A backup is taken first and Claude's / Copilot's
                                     own files stay, so `tether undelete` (or the Backups popup) brings it
                                     back. --close first closes the space in Herdr if it is open and waits
                                     for its agents to exit. --sessions makes it permanent: also deletes the
                                     sessions' transcripts AND their backup copies. Asks first unless -y.
                                     --id <space-id> picks by exact id.
    tether <space name>              same as `tether open <space name>`
    tether search <words or a question> [--scope open,closed,deleted] [--rank] [--deep] [--json]
                                     find a conversation by what was said in it. Default: a free local
                                     keyword search over open and closed spaces. --rank asks Claude to
                                     rank the best candidates from short digests (cheap, one call);
                                     --deep reads the full text of the top few (--sessions id,id for
                                     chosen ones) with one Claude call each. `deleted` also searches
                                     the backup of deleted spaces. Prints an estimate of the token cost.
    tether read <space> [--last N] [--commands] [--full] [--id X | --session S] [--json]
                                     print what a space's conversation said (the last N messages, default
                                     12, each cut at 1,500 characters unless --full): to bring context from
                                     another thread into this one. Never tool output. Find the space with
                                     `tether list` or `tether search`.
    tether adopt [--id <space-id>] [--json]
                                     link agents that are running in herdr terminals but were started
                                     without tether (plain `claude` / `copilot`): their sessions are
                                     read from the running processes. `fork` does this first.
    tether fork [space] [--id X] [-y]
                                     copy a space into a new one named "<name> (fork)": every linked
                                     session is copied, so the two continue separately from the point
                                     you forked. The original is untouched (and backed up first).
    tether undelete [space] [--list] [--json]
                                     bring back a space you deleted (unlinked), from the backup's record
                                     of it; it shows up as a closed space again. --id <space-id> picks
                                     by exact id. Deleting with "Unlink only" takes a backup first.
    tether open-session <id> [--agent claude|copilot]
                                     put one session back in a new tab of the space that linked it
                                     (restoring its transcript from the backup if it has gone)

  Setup and health
    tether --version                 print the version of tether
    tether doctor [--json]           check the install, Herdr, links and backups; says how to fix each
                                     problem. Exit status 1 if something needs attention.
    tether config [home_dir [path|--unset|--default]]
                                     show or change settings. home_dir: a folder to start NEW agents
                                     in when you are in your home folder (default ~/.local/share/tether/home; --unset turns it off). (Claude asks "trust this
                                     folder?" for home on every start, but remembers other folders)

  Backups (conversations live in each agent's own folder; Claude deletes old ones)
    tether backup [space] [--quiet]  copy the transcripts of every linked session into the backup
                                     folder (incremental; never deletes from it). --id <space-id> picks
                                     one space exactly; --json prints the result; --status [--json]
                                     shows what the backup holds instead of copying; --list [--json]
                                     lists every backed-up session by space, tab and first message.
    tether backup --forget --session <id> [--agent claude|copilot] [--everything]
                                     delete one session's copy from the backup (any session; a session the
                                     agent still has is copied again by the next backup). --everything
                                     also deletes the agent's own copy: permanent, refuses a running session.
    tether backup --forget --id <space-id>
                                     remove a DELETED space from the backup. Refuses a space tether still links; never touches Claude's
                                     or Copilot's own files.
    tether restore [space | --id X]  copy missing transcripts back from the backup folder. `tether claude`
                                     does this by itself when a linked transcript has gone.
                                     --session <id> [--agent claude|copilot] restores that one session
                                     (even if no space links it any more).
    tether export <space> [-o file]  bundle a space's links + transcripts into one .tar.gz (private, 0600).
                                     -o may be a folder; --id <space-id>; --json prints the file's path.
    tether import <file> [--name N]  restore such a bundle as a closed space; then `tether open <name>`

How it works
  * A link belongs to a terminal: space id + terminal address (t1, t5, ...) + agent + session.
    The space id is stable across renames and restarts, so the name is only a label. After a
    restart herdr keeps tabs and gives each lost terminal a plain shell with the same address,
    which is what lets `tether open` put every terminal back.
  * First run in a terminal: a new UUID, `--session-id <uuid>`. Later: `--resume <uuid>` from
    the folder the session was started in.
  * Outside herdr, or if the space cannot be resolved, a plain agent is started.
    This script never stops you from running the agent.

Environment
  TETHER_STATE_DIR   where links are stored (default ~/.local/state/tether)
  TETHER_HOME_DIR    overrides "home_dir" in config.json (see `tether config`)
  TETHER_SEARCH_MODEL  model for the AI steps of `tether search` (default: "search_model" in
                     config.json, else sonnet)
  TETHER_NO_ADOPT=1  never link agents started without tether (see `tether adopt`)
  TETHER_NO_CD=1     do not change to the folder the session was started in
  TETHER_FORCE=1     start even if this session looks to be running already
  TETHER_DRY_RUN=1   print what would run; write nothing, start nothing
  TETHER_BACKUP_DIR  backup folder (default: "backup_dir" in <state dir>/config.json, else
                     ~/.local/share/tether/backups). If it is inside a git repo it must be git-ignored.
  TETHER_AUTO_BACKUP 1/0: back up in the background when an agent is launched (at most every 6 h);
                     default: "auto" in config.json
"""

__version__ = "0.1.2"  # keep in step with the VERSION file (tests check it)

import ast
import concurrent.futures
import collections
import math
import contextlib
import fcntl
import functools
import glob
import hashlib
import io
import json
import os
import re
import secrets
import shutil
import subprocess
import sys
import tarfile
import time
from collections import namedtuple
from datetime import datetime, timezone
from uuid import uuid4

AGENTS = ("claude", "copilot")

# If you pass one of these yourself you are choosing the session: tether steps aside.
EXPLICIT_SESSION_FLAGS = {
    "claude": {"--resume", "-r", "--continue", "-c", "--session-id", "--fork-session"},
    "copilot": {"--resume", "-r", "--continue", "--session-id", "--connect"},
}

COMMANDS = {"claude", "copilot", "read", "search", "resume", "link", "list", "open", "delete", "touch", "status", "reset",
            "backup", "restore", "export", "import", "help", "-h", "--help"}


class TetherError(Exception):
    pass


def env(name):
    """The TETHER_<name> environment variable, or None."""
    return os.environ.get("TETHER_" + name)


def say(msg):
    print(f"tether: {msg}", file=sys.stderr)


TOOL_DIRS = ("~/.local/bin", "/opt/homebrew/bin", "/usr/local/bin")


def find_tool(name):
    """A program on PATH, else in the usual install folders. The herdr app (and so the mods it
    runs) has a minimal PATH without ~/.local/bin, which is where herdr-app and hc live."""
    found = shutil.which(name)
    if found:
        return found
    for d in TOOL_DIRS:
        cand = os.path.join(os.path.expanduser(d), name)
        if os.path.isfile(cand) and os.access(cand, os.X_OK):
            return cand
    return None


def now():
    return datetime.now(timezone.utc).isoformat(timespec="seconds")


def ago(iso):
    try:
        secs = (datetime.now(timezone.utc) - datetime.fromisoformat(iso)).total_seconds()
    except (TypeError, ValueError):
        return "unknown"
    if secs < 90:
        return "just now"
    for unit, n in (("d", 86400), ("h", 3600), ("min", 60)):
        if secs >= n:
            return f"{int(secs // n)} {unit} ago"
    return "just now"


def state_dir():
    """Where links are stored: $TETHER_STATE_DIR, else ~/.local/state/tether."""
    return env("STATE_DIR") or os.path.expanduser("~/.local/state/tether")


# ---------- which space / terminal am I in? ----------

Where = namedtuple("Where", "space_id name terminal tab tab_name")


def herdr_ls():
    """The `herdr-app ls` spaces list, or TetherError saying why not."""
    app = find_tool("herdr-app")
    if not app:
        raise TetherError("herdr-app not found on PATH")
    try:
        out = subprocess.run([app, "ls"], capture_output=True, text=True, timeout=5)
        return json.loads(out.stdout)["spaces"]
    except Exception as e:  # timeout, app not running, bad JSON
        raise TetherError(f"could not read `herdr-app ls` ({type(e).__name__})")


def ensure_app():
    """Make sure the herdr app is running, starting it if not (from a plain terminal).
    Inside a herdr terminal it obviously is. Everything tether does to spaces needs the app."""
    if os.environ.get("HC_TERMINAL_ID"):
        return
    try:
        herdr_ls()
        return
    except TetherError as first:
        err = first
    app = find_tool("herdr-app")
    if not app:
        raise err
    say("herdr-app is not running; starting it...")
    real = os.path.realpath(app)
    bundle = real.split(".app/")[0] + ".app" if ".app/" in real else None
    if sys.platform == "darwin" and bundle and os.path.isdir(bundle):
        subprocess.run(["open", bundle])
    else:
        subprocess.Popen([app], stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                         stderr=subprocess.DEVNULL, start_new_session=True)
    for _ in range(30):
        time.sleep(1)
        try:
            herdr_ls()
            time.sleep(1)  # let it finish restoring its spaces
            return
        except TetherError:
            continue
    raise TetherError("started herdr-app, but it did not become ready within 30 s; open it "
                      "yourself and run tether again")


def terms_of(node):
    """Every terminal dict under a tab (sub-agents included)."""
    if isinstance(node, dict):
        if isinstance(node.get("terminal"), str):
            yield node
        for v in node.values():
            yield from terms_of(v)
    elif isinstance(node, list):
        for v in node:
            yield from terms_of(v)


def find_terminal(spaces, tid):
    """(space, tab, terminal dict) for an address; exact first, then machine-prefixed."""
    for exact in (True, False):
        hits = []
        for s in spaces:
            for tab in s.get("tabs", []):
                for t in terms_of(tab):
                    a = t["terminal"]
                    if a == tid if exact else a.endswith("/" + tid):
                        hits.append((s, tab, t))
        if len({h[0]["id"] for h in hits}) > 1:
            raise TetherError(f"terminal {tid} matches more than one space; not guessing")
        if hits:
            return hits[0]
    return None


def resolve_where():
    """(Where, None), or (None, reason) if this is not a herdr-app terminal."""
    tid = os.environ.get("HC_TERMINAL_ID")
    if not tid:
        return None, "not running inside a herdr terminal (HC_TERMINAL_ID is not set)"
    try:
        hit = find_terminal(herdr_ls(), tid)
    except TetherError as e:
        return None, str(e)
    if not hit:
        return None, f"terminal {tid} is not in any herdr-app space"
    s, tab, t = hit
    return Where(s["id"], s.get("name") or "", t["terminal"], tab.get("id") or "",
                 tab.get("name") or ""), None


# ---------- stored links ----------

class State:
    """spaces.json under an exclusive lock; read-modify-write is atomic.

    spaces[space_id] = {name, terminals: {address: link}, agents: {agent: link}}
    `agents` is the older per-space format; such a link is adopted by the next terminal in that
    space that runs that agent."""

    def __enter__(self):
        os.makedirs(state_dir(), exist_ok=True)
        self.path = os.path.join(state_dir(), "spaces.json")
        self.lock = open(os.path.join(state_dir(), "lock"), "w")
        fcntl.flock(self.lock, fcntl.LOCK_EX)
        try:
            with open(self.path) as f:
                self.data = json.load(f)
        except FileNotFoundError:
            self.data = {}
        except json.JSONDecodeError:
            backup = f"{self.path}.corrupt-{int(datetime.now().timestamp())}"
            os.replace(self.path, backup)
            say(f"spaces.json was invalid; kept as {backup}")
            self.data = {}
        self.old_format = bool(self.data) and not any("terminals" in s for s in self.data.values())
        return self

    def save(self):
        if self.old_format and os.path.exists(self.path):
            keep = self.path + ".v1-backup"
            if not os.path.exists(keep):
                shutil.copy2(self.path, keep)
        tmp = self.path + ".tmp"
        with open(tmp, "w") as f:
            json.dump(self.data, f, indent=2, sort_keys=True)
        os.replace(tmp, self.path)

    def __exit__(self, *exc):
        self.lock.close()


def all_links(data):
    """(space_id, space, address-or-None, link) for every stored link."""
    for sid, sp in data.items():
        for addr, e in sp.get("terminals", {}).items():
            yield sid, sp, addr, e
        for agent, e in sp.get("agents", {}).items():
            yield sid, sp, None, dict(e, agent=agent)


def last_used(sp):
    """When the space was last launched in or switched to (`touch`), newest of both."""
    stamps = [e.get("last_used", "") for e in sp.get("terminals", {}).values()]
    stamps += [e.get("last_used", "") for e in sp.get("agents", {}).values()]
    stamps.append(sp.get("accessed", ""))
    return max(stamps, default="")


def _started(pid):
    r = subprocess.run(["ps", "-p", str(pid), "-o", "lstart="], capture_output=True, text=True)
    return r.stdout.strip()


def _running(entry, agent):
    """Is the process that last launched this link still alive and still the same one?
    Compares the process start time, so a recycled pid is not mistaken for it."""
    pid, started = entry.get("pid"), entry.get("pid_started")
    if not pid or not started or pid == os.getpid():
        return False
    try:
        os.kill(pid, 0)
    except (ProcessLookupError, PermissionError):
        return False
    r = subprocess.run(["ps", "-p", str(pid), "-o", "command="], capture_output=True, text=True)
    return _started(pid) == started and agent in r.stdout


def running_link(data, session, agent):
    """Any stored link to this session whose launcher is still alive."""
    for _, _, _, e in all_links(data):
        if e.get("session") == session and _running(e, agent):
            return e
    return None


def _claude_home():
    return os.environ.get("CLAUDE_CONFIG_DIR") or os.path.expanduser("~/.claude")


def _copilot_home():
    return os.environ.get("COPILOT_HOME") or os.path.expanduser("~/.copilot")


def session_exists(agent, session):
    if agent == "claude":
        return bool(glob.glob(os.path.join(_claude_home(), "projects", "*", f"{session}.jsonl")))
    return os.path.isdir(os.path.join(_copilot_home(), "session-state", session))


def _newest(paths):
    paths = [p for p in paths if os.path.exists(p)]
    return max(paths, key=os.path.getmtime) if paths else None


def ancestors():
    """Parent pids of this process, nearest first."""
    pids, pid = [], os.getppid()
    while pid and pid != 1 and pid not in pids:
        pids.append(pid)
        r = subprocess.run(["ps", "-o", "ppid=", "-p", str(pid)], capture_output=True, text=True)
        try:
            pid = int(r.stdout.strip())
        except ValueError:
            break
    return pids


def ancestor_pids():
    return set(ancestors())


def _is_agent_command(command, agent):
    """Is this process command line the agent itself (`claude ...`, `node /x/copilot ...`), as
    opposed to a shell that merely has the word in its arguments?"""
    parts = command.split()
    if not parts:
        return False
    names = [os.path.basename(parts[0])]
    if names[0] in ("node", "bun", "deno") and len(parts) > 1:
        names.append(os.path.basename(parts[1]).removesuffix(".js"))
    return agent in names


def agent_process(agent):
    """(pid, start time) of the agent process this command is running under, else (None, None)."""
    for pid in ancestors():
        r = subprocess.run(["ps", "-p", str(pid), "-o", "command="], capture_output=True, text=True)
        if _is_agent_command(r.stdout, agent):
            return pid, _started(pid)
    return None, None


def current_session(agent):
    """The session this command is running inside of (exact, not a guess), or None.
    claude: Claude Code puts its session id in $CLAUDE_CODE_SESSION_ID.
    copilot: the live session's folder holds inuse.<pid>.lock for the copilot process, which
    is one of our ancestors."""
    if agent == "claude":
        sid = os.environ.get("CLAUDE_CODE_SESSION_ID")
        return sid if sid and session_exists("claude", sid) else None
    mine = ancestor_pids()
    for lock in glob.glob(os.path.join(_copilot_home(), "session-state", "*", "inuse.*.lock")):
        try:
            if int(os.path.basename(lock).split(".")[1]) in mine:
                return os.path.basename(os.path.dirname(lock))
        except (ValueError, IndexError):
            pass
    return None


def guess_session(agent):
    """Most recently written session: for claude, in this folder; for copilot, anywhere."""
    if agent == "claude":
        enc = "".join(c if c.isalnum() else "-" for c in os.path.realpath(os.getcwd()))
        hit = _newest(glob.glob(os.path.join(_claude_home(), "projects", enc, "*.jsonl")))
        return os.path.basename(hit)[:-len(".jsonl")] if hit else None
    hit = _newest(glob.glob(os.path.join(_copilot_home(), "session-state", "*")))
    return os.path.basename(hit) if hit else None


def session_cwd(agent, session):
    """Folder a claude session was started in (read from its transcript), else the current one."""
    if agent == "claude":
        for f in glob.glob(os.path.join(_claude_home(), "projects", "*", f"{session}.jsonl")):
            try:
                with open(f) as fh:
                    for _, line in zip(range(50), fh):
                        c = json.loads(line).get("cwd")
                        if c and os.path.isdir(c):
                            return c
            except (OSError, ValueError):
                pass
    return os.getcwd()


def pick(prompt, items):
    """Arrow-key menu. items: [(label, value)] or [(label, value, pinned)]; pinned entries stay
    visible whatever you type and are drawn in green. Up/down (or ctrl-p/ctrl-n) move, enter
    selects, typing filters, esc / ctrl-c cancels. Returns the value, or None."""
    import select
    import termios
    import tty
    items = [(it + (False,))[:3] for it in items]
    if not items:
        return None
    if not (sys.stdin.isatty() and sys.stdout.isatty()):
        raise TetherError("need a terminal to pick from a list; pass a name")
    fd = sys.stdin.fileno()
    saved = termios.tcgetattr(fd)
    query, sel, drawn = "", 0, 0
    out = sys.stdout

    def visible():
        q = query.lower()
        return [it for it in items if it[2] or q in it[0].lower()]

    def first_match():
        """While filtering, start on the first real match, not the pinned entries."""
        vis = visible()
        if query:
            for i, it in enumerate(vis):
                if not it[2]:
                    return i
        return 0

    def draw():
        nonlocal sel, drawn
        vis = visible()
        sel = max(0, min(sel, len(vis) - 1))
        room = max(5, shutil.get_terminal_size().lines - 4)
        top = max(0, min(sel - room // 2, len(vis) - room))
        window = vis[top:top + room]
        lines = [f"\x1b[1m{prompt}\x1b[0m {query}\x1b[2m"
                 f"{'' if query else ' (type to filter)'}   up/down, enter, esc\x1b[0m"]
        for i, (label, _, pinned) in enumerate(window, start=top):
            text = f"\x1b[1;32m{label}\x1b[0m" if pinned else label
            lines.append(f"\x1b[7m> {text}\x1b[0m" if i == sel else f"  {text}")
        hidden = len(vis) - len(window)
        if hidden > 0:
            lines.append(f"\x1b[2m  ... {hidden} more (keep going up/down, or type to filter)\x1b[0m")
        if drawn:
            out.write(f"\x1b[{drawn}A")
        out.write("\r\x1b[J" + "\n".join(lines) + "\n")
        out.flush()
        drawn = len(lines)

    def clear():
        if drawn:
            out.write(f"\x1b[{drawn}A\r\x1b[J")
            out.flush()

    try:
        tty.setcbreak(fd)
        out.write("\x1b[?25l")
        draw()
        while True:
            ch = os.read(fd, 1)
            if ch == b"\x1b":
                if select.select([fd], [], [], 0.05)[0]:
                    seq = os.read(fd, 2)
                    if seq in (b"[A", b"OA"):
                        sel -= 1
                    elif seq in (b"[B", b"OB"):
                        sel += 1
                    # other escape sequences (left/right...) are ignored
                else:
                    clear()
                    return None
            elif ch in (b"\r", b"\n"):
                vis = visible()
                clear()
                return vis[sel][1] if vis else None
            elif ch in (b"\x03", b"\x04"):
                clear()
                return None
            elif ch == b"\x10":
                sel -= 1
            elif ch == b"\x0e":
                sel += 1
            elif ch in (b"\x7f", b"\x08"):
                query = query[:-1]
                sel = first_match()
            elif ch and ch[0] >= 32:
                try:
                    query += (ch + (os.read(fd, 3) if ch[0] >= 0xC0 else b"")).decode()
                except UnicodeDecodeError:
                    pass
                sel = first_match()
            draw()
    finally:
        out.write("\x1b[?25h")
        out.flush()
        termios.tcsetattr(fd, termios.TCSADRAIN, saved)


# ---------- starting an agent ----------

def plain(agent, args, why):
    say(f"{why}; starting plain {agent}")
    binary = find_tool(agent)
    if not binary:
        sys.exit(f"tether: {agent} not found on PATH")
    if env("DRY_RUN"):
        print("would run:", " ".join([agent] + args))
        return
    os.execvp(binary, [agent] + args)


def launch(agent, args):
    flags = {a.split("=", 1)[0] for a in args}
    if flags & EXPLICIT_SESSION_FLAGS[agent]:
        return plain(agent, args, "you chose a session explicitly")

    where, why = resolve_where()
    if where is None:
        return plain(agent, args, why)

    binary = find_tool(agent)
    if not binary:
        sys.exit(f"tether: {agent} not found on PATH")
    dry = bool(env("DRY_RUN"))

    with State() as st:
        space = st.data.setdefault(where.space_id, {})
        terms = space.setdefault("terminals", {})
        legacy = space.setdefault("agents", {})
        entry = terms.get(where.terminal)
        replaced = None

        if entry and entry["agent"] != agent:
            replaced, entry = entry, None
        elif entry and entry.get("tab") and entry["tab"] != where.tab:
            say(f"{where.terminal} is in a different tab than when it was linked "
                f"(address reused?); not resuming the old session")
            replaced, entry = entry, None
        if not entry and agent in legacy and not _running(legacy[agent], agent):
            entry = legacy.pop(agent)
            say(f"using this space's earlier {agent} session for this terminal")
        if replaced:
            say(f"replacing this terminal's {replaced['agent']} link (transcript kept; reopen "
                f"with: {replaced['agent']} --resume {replaced['session']})")

        if entry:
            other = running_link(st.data, entry["session"], agent)
            if other and not env("FORCE"):
                sys.exit(
                    f"tether: this {agent} session is already running (pid {other['pid']}).\n"
                    f"        Two copies on one session would write over each other.\n"
                    f"        Use that one, run plain `{agent}` for a separate session, "
                    f"or TETHER_FORCE=1 to override."
                )

        cwd = os.getcwd()
        resume = bool(entry) and session_exists(agent, entry["session"])
        # a forked Claude tab: the first start forks the original into this link's session id
        fork_src = entry.get("fork_of") if entry and not resume and agent == "claude" else None
        if fork_src and not session_exists(agent, fork_src):
            if restore_session(agent, fork_src):
                say(f"restored the original session {fork_src[:8]} from the backup")
            if not session_exists(agent, fork_src):
                say(f"the session this was forked from ({fork_src[:8]}) is gone; starting a new one")
                fork_src = None
        if entry and not resume and not fork_src:
            backed_up = bool(session_files(agent, entry["session"], os.path.join(backup_dir(), agent)))
            if backed_up and dry:
                say(f"linked session {entry['session'][:8]} is gone, but a backup has it: it would be restored")
                resume = True
            elif backed_up and restore_session(agent, entry["session"]):
                say(f"linked session {entry['session'][:8]} was gone; restored it from the backup")
                resume = session_exists(agent, entry["session"])
        if entry and not resume and not fork_src:
            say(f"linked session {entry['session'][:8]} has no transcript (never used, or cleaned "
                f"up); starting a new one")
        if resume or fork_src:
            session = entry["session"]
            target = entry.get("cwd")
            if target and os.path.isdir(target) and not env("NO_CD"):
                if os.path.realpath(target) != os.path.realpath(cwd):
                    say(f"resuming in {target} (where this session started)")
                cwd = target
            elif target and not os.path.isdir(target):
                say(f"{target} no longer exists; resuming from {cwd}")
        else:
            session = str(uuid4())
            alt = home_dir_setting()
            if alt and os.path.realpath(cwd) == os.path.realpath(os.path.expanduser("~")) \
                    and not env("NO_CD"):
                say(f"starting in {alt} (home_dir), so {agent} does not ask to trust your home folder")
                cwd = alt

        label = where.name.strip()
        if label and any(a != where.terminal for a in terms):
            label = f"{label} · {where.tab_name}" if where.tab_name else label
        if agent == "claude":
            if fork_src:
                cmd = [agent, "--resume", fork_src, "--fork-session", "--session-id", session]
            else:
                cmd = [agent, "--resume" if resume else "--session-id", session]
            if label:
                cmd += ["--name", label]
        else:
            cmd = [agent, f"--resume={session}" if resume else f"--session-id={session}"]
            if label and not resume:  # copilot only accepts a name for a new session
                cmd += [f"--name={label}"]
        cmd += args

        if dry:
            print(f"space   : {where.space_id} ({where.name!r})  terminal {where.terminal} "
                  f"tab {where.tab_name!r}")
            print(f"session : {session} ({'resume' if resume else 'new'})")
            print(f"would run: cd {cwd} && {' '.join(cmd)}")
            return

        space["name"] = where.name
        terms[where.terminal] = {
            "agent": agent,
            "session": session,
            "cwd": (entry.get("cwd") or cwd) if (resume or fork_src) else cwd,
            "tab": where.tab,
            "tab_name": where.tab_name,
            "created": (entry.get("created") if entry else None) or now(),
            **({"fork_of": fork_src} if fork_src else {}),
            "last_used": now(),
            "pid": os.getpid(),  # becomes the agent's pid after exec
            "pid_started": _started(os.getpid()),
        }
        st.save()

    auto_backup_if_due()
    os.chdir(cwd)
    os.execvp(binary, cmd)


def resume_here():
    """Bare `tether` / `tether resume` inside a terminal: whatever this terminal had."""
    where, why = resolve_where()
    if where is None:
        sys.exit(f"tether: {why}")
    with State() as st:
        entry = st.data.get(where.space_id, {}).get("terminals", {}).get(where.terminal)
    if not entry:
        sys.exit("tether: nothing is linked to this terminal yet; run `tether claude` or "
                 "`tether copilot` (or `tether link claude [id]` for an existing session)")
    launch(entry["agent"], [])


# ---------- link / status / reset ----------

def link(agent, session):
    where, why = resolve_where()
    if where is None:
        sys.exit(f"tether: {why}")
    how = "given"
    if session is None:
        session = current_session(agent)
        how = "detected: the session this command is running in"
        if not session:
            session = guess_session(agent)
            how = ("GUESSED: the most recent one in this folder" if agent == "claude"
                   else "GUESSED: the most recent one anywhere")
            if not session:
                sys.exit(f"tether: no {agent} session found to link; pass an id: "
                         f"tether link {agent} <session-id>")
    if not session_exists(agent, session):
        sys.exit(f"tether: no {agent} session {session!r} found on disk")
    with State() as st:
        running = running_link(st.data, session, agent)
        if running and not env("FORCE"):
            sys.exit(f"tether: that session is running under another link (pid {running['pid']}); "
                     f"TETHER_FORCE=1 to move it anyway")
        # a session belongs to exactly one terminal: take it from wherever it was
        moved = []
        for sid, sp, addr, e in list(all_links(st.data)):
            if e.get("session") == session and not (sid == where.space_id and addr == where.terminal):
                (sp["terminals"].pop(addr) if addr else sp["agents"].pop(e["agent"]))
                moved.append(sp.get("name") or sid)
        space = st.data.setdefault(where.space_id, {})
        space.setdefault("agents", {})
        old = space.setdefault("terminals", {}).get(where.terminal)
        space["name"] = where.name
        space["terminals"][where.terminal] = {
            "agent": agent,
            "session": session,
            "cwd": session_cwd(agent, session),
            "tab": where.tab,
            "tab_name": where.tab_name,
            "created": (old.get("created") if old else None) or now(),
            "last_used": now(),
        }
        if how.startswith("detected"):  # we are inside that session, so we know its process
            pid, started = agent_process(agent)
            if pid:
                space["terminals"][where.terminal].update(pid=pid, pid_started=started)
        st.save()
    print(f"linked {agent} session {session} ({how}) to terminal {where.terminal} "
          f"[{where.tab_name or 'tab'}] in space {where.name!r}")
    if old and old["session"] != session:
        print(f"  replaced {old['agent']} {old['session']} (transcript kept)")
    if moved:
        print(f"  moved it from: {', '.join(moved)}")
    if how.startswith("GUESSED"):
        print(f"  could not tell which {agent} session this is, so this is a guess; if it is the "
              f"wrong one, run: tether link {agent} <session-id>")
    print("  `tether` in this terminal resumes it; after a restart, `tether` here (or "
          "`tether open <space>` for the whole space)")


def status():
    where, why = resolve_where()
    if where is None:
        sys.exit(f"tether: {why}")
    try:
        live = {t["terminal"]: tab.get("id") for s in herdr_ls() if s["id"] == where.space_id
                for tab in s.get("tabs", []) for t in terms_of(tab)}
    except TetherError:
        live = None
    print(f"space: {where.name!r}  ({where.space_id})   this terminal: {where.terminal}")
    with State() as st:
        space = st.data.get(where.space_id, {})
    terms = space.get("terminals", {})
    for addr, e in sorted(terms.items()):
        flags = ["running" if _running(e, e["agent"]) else "idle"]
        flags.append("transcript found" if session_exists(e["agent"], e["session"])
                     else "transcript MISSING")
        if live is not None and addr not in live:
            flags.append("terminal gone")
        elif live is not None and e.get("tab") and live[addr] != e["tab"]:
            flags.append("terminal moved to another tab")
        here = " <- here" if addr == where.terminal else ""
        print(f"  {addr:<5} [{e.get('tab_name') or '?'}]  {e['agent']}: {e['session']}  "
              f"[{', '.join(flags)}]{here}")
        print(f"        cwd {e.get('cwd')}   last used {ago(e.get('last_used'))}")
    for agent, e in space.get("agents", {}).items():
        print(f"  (no terminal)  {agent}: {e['session']}  earlier link; the next terminal here "
              f"that runs `tether {agent}` takes it over")
    if not terms and not space.get("agents"):
        print("  nothing linked yet; run `tether claude` or `tether copilot`")


def reset(which):
    where, why = resolve_where()
    if where is None:
        sys.exit(f"tether: {why}")
    with State() as st:
        space = st.data.get(where.space_id, {})
        terms, legacy = space.get("terminals", {}), space.get("agents", {})
        removed = []
        e = terms.get(where.terminal)
        if e and (not which or e["agent"] == which):
            removed.append(terms.pop(where.terminal))
        elif not e:
            for agent in ([which] if which else list(legacy)):
                if agent in legacy:
                    removed.append(dict(legacy.pop(agent), agent=agent))
        for r in removed:
            print(f"unlinked {r['agent']} from {where.name!r}; transcript kept, "
                  f"reopen it with: {r['agent']} --resume {r['session']}")
        if not removed:
            print("nothing to reset")
        st.save()


# ---------- spaces: list / open ----------

def touch(space_id):
    """Record that a space was just switched to. Only spaces that already have links. Agents running
    in this space without a tether link are linked first."""
    safe_adopt(space_id)
    with State() as st:
        sp = st.data.get(space_id)
        if sp and (sp.get("terminals") or sp.get("agents")):
            sp["accessed"] = now()
            st.save()


def list_json():
    """Machine-readable `list`, newest first: what the herdr mod reads."""
    try:
        names = {s["id"]: s.get("name") for s in herdr_ls()}
        live = set(names)
    except TetherError as e:
        # exit non-zero: a caller must not read "no closed spaces" from an unreadable herdr
        sys.exit(f"tether: {e}")
    with State() as st:
        data = st.data
    out = []
    for sid, sp in data.items():
        if not (sp.get("terminals") or sp.get("agents")):
            continue
        links = [{"agent": e["agent"], "tab_name": e.get("tab_name") or "", "session": e["session"],
                  "transcript": session_exists(e["agent"], e["session"]),
                  "recoverable": has_backup(e["agent"], e["session"])}
                 for _, _, _, e in all_links({sid: sp})]
        out.append({"id": sid, "name": names.get(sid) or sp.get("name") or sid,
                    "last_used": last_used(sp), "closed": live is not None and sid not in live,
                    "forked_from": (sp.get("forked_from") or {}).get("name"),
                    "links": links})
    out.sort(key=lambda r: r["last_used"], reverse=True)
    print(json.dumps(out))


def list_all(args):
    if "--json" in args:
        return list_json()
    show_all = "--all" in args
    needle = " ".join(a for a in args if a != "--all").strip().lower()
    try:
        names = {s["id"]: s.get("name") for s in herdr_ls()}
        live = set(names)
    except TetherError as e:
        names, live = {}, None
        say(f"{e}; can't tell which spaces still exist")
    with State() as st:
        data = st.data
    rows = []
    for sid, sp in data.items():
        if not (sp.get("terminals") or sp.get("agents")):
            continue
        gone = live is not None and sid not in live
        label = names.get(sid) or sp.get("name") or sid
        hay = (label + " " + " ".join(e.get("session", "") for _, _, _, e in
               all_links({sid: sp}))).lower()
        if needle and needle not in hay:
            continue
        rows.append((last_used(sp), sid, dict(sp, name=label), gone))
    for last, sid, sp, gone in sorted(rows, key=lambda r: r[0], reverse=True):
        print(f"{sp.get('name') or sid:<32} {ago(last):<12}" + ("  (closed)" if gone else ""))
        if gone and show_all:
            for _, _, addr, e in all_links({sid: sp}):
                print(f"    {e['agent']:<8} {e.get('tab_name') or '':<18} "
                      f"reopen: {e['agent']} --resume {e['session']}")
    if not rows:
        print("no matching spaces" if needle else "nothing linked yet")


def herdr_do(args):
    """Run `herdr-app do <args>`; returns what it made ({space, tab, terminal}) or raises."""
    app = find_tool("herdr-app")
    if not app:
        raise TetherError("herdr-app not found on PATH")
    r = subprocess.run([app, "do"] + args, capture_output=True, text=True, timeout=15)
    try:
        made = json.loads(r.stdout)
    except ValueError:
        made = {"error": (r.stderr or r.stdout).strip()[:200] or "no output"}
    if r.returncode or "error" in made:
        raise TetherError(f"herdr-app do {args[0]} failed: {made.get('error')}")
    return made


def space_rows(live, data, openable_only=False):
    """[(space_id, name, last_used, closed)], newest first. openable_only: just the spaces
    `open` can do something with: closed ones, and open ones with an idle linked terminal."""
    rows = []
    for k, sp in data.items():
        if not (sp.get("terminals") or sp.get("agents")):
            continue
        closed = k not in live
        if openable_only and not closed and not plan_space(sp, live[k])[3]:
            continue
        name = sp.get("name") if closed else live[k].get("name")
        rows.append((k, name or k, last_used(sp), closed))
    rows.sort(key=lambda r: r[2], reverse=True)
    return rows


def row_label(name, last, closed=False):
    return f"{name:<32} {ago(last)}"


def reopen_closed(sid, sp, yes):
    """Recreate a closed space with a tab per linked terminal and resume each session in it."""
    name = sp.get("name") or sid
    items = [(e.get("tab_name") or "", e) for _, e in sorted(sp.get("terminals", {}).items())]
    items += [(agent, dict(e, agent=agent)) for agent, e in sp.get("agents", {}).items()]
    old_addr = {id(e): a for a, e in sp.get("terminals", {}).items()}
    ok = list(items)
    print(f"space {name!r} is closed")
    for t, e in items:
        note = ("-> new tab, resume" if available(e["agent"], e["session"])
                else "-> new tab, fresh session (nothing to resume yet)")
        print(f"  [{t or e['agent']}]  {e['agent']} {e['session'][:8]}  {note}")
    if not ok:
        print("nothing to restore")
        return
    if not yes:
        if not sys.stdin.isatty():
            sys.exit("tether: not a terminal; pass -y to recreate the space")
        if input(f"recreate {name!r} with {len(ok)} tab(s) and resume them? [y/N] ").strip().lower() != "y":
            print("cancelled")
            return
    if not find_tool("hc"):
        raise TetherError("hc not found on PATH")
    new_space, created = None, []
    done = set()  # ids of the (tab name, link) items that now have a terminal
    try:
        for tab_name, e in ok:
            folder = e.get("cwd") if e.get("cwd") and os.path.isdir(e["cwd"]) else os.getcwd()
            if new_space is None:
                args = ["space.new", "--name", name, "--folder", folder]
                args += ["--tab", tab_name] if tab_name else []
            else:
                args = ["tab.new", "--space", new_space, "--folder", folder]
                args += ["--name", tab_name] if tab_name else []
            made = herdr_do(args)
            if not made.get("terminal"):
                raise TetherError(f"herdr-app did not return a terminal for {tab_name or e['agent']!r}")
            new_space = new_space or made.get("space")
            created.append((made["terminal"], tab_name, e))
            done.add(id(e))
    except TetherError as err:
        say(str(err))
    if not created:
        raise TetherError("could not recreate the space")
    now_live = herdr_ls()
    with State() as st:
        if not new_space:  # find it from the first terminal we made
            hit = find_terminal(now_live, created[0][0])
            new_space = hit[0]["id"] if hit else None
        if not new_space:
            raise TetherError("created terminals but could not tell which space they are in")
        sp_new = st.data.setdefault(new_space, {})
        sp_new.setdefault("agents", {})
        sp_new["name"] = name
        terms = sp_new.setdefault("terminals", {})
        for term, tab_name, e in created:
            hit = find_terminal(now_live, term)
            link = {k: e[k] for k in ("agent", "session", "cwd", "created") if e.get(k)}
            link.update(tab=(hit[1].get("id") if hit else "") or "", tab_name=tab_name,
                        last_used=e.get("last_used") or now())
            terms[term] = link
        left = [(t, e) for t, e in ok if id(e) not in done]
        if new_space != sid:
            if left:
                # some tabs could not be recreated: keep their links under the closed space so
                # they can be reopened later, instead of forgetting them
                kept = {"name": name, "terminals": {}, "agents": {}}
                for _, e in left:
                    if id(e) in old_addr:
                        kept["terminals"][old_addr[id(e)]] = e
                    else:
                        kept["agents"][e["agent"]] = {k: v for k, v in e.items() if k != "agent"}
                st.data[sid] = kept
                say(f"{len(left)} of {len(ok)} tab(s) could not be recreated; their links are kept "
                    f"in the closed space {name!r}")
            else:
                st.data.pop(sid, None)  # the closed space is now this one
        st.save()
    typed = f"{tether_cmd()} resume"
    for term, tab_name, e in created:
        r = subprocess.run([find_tool("hc"), "send", term, typed], capture_output=True, text=True)
        if r.returncode:
            say(f"could not type into {term}: {(r.stderr or r.stdout).strip()[:200]}")
        else:
            print(f"  {term} [{tab_name or e['agent']}]: resuming {e['agent']}")
    print(f"recreated space {name!r}")


def match_space(query, rows):
    """rows: [(id, name, last, closed)] -> chosen id, or None if nothing matches."""
    q = query.strip().lower()
    exact = [r for r in rows if r[1].lower() == q]
    cands = exact or [r for r in rows if q in r[1].lower()]
    if not cands:
        return None
    if len(cands) == 1:
        return cands[0][0]
    return pick(f"{len(cands)} spaces match {query!r}:",
                [(row_label(n, l, c), i) for i, n, l, c in cands])


def plan_space(sp_data, space):
    """What `open` would do for an open space: (terms, legacy, adopted, plan, skipped).
    plan = [(address, tab name, link)] to type `tether resume` into."""
    here = {t["terminal"]: (tab, t) for tab in space.get("tabs", []) for t in terms_of(tab)}
    terms = dict(sp_data.get("terminals", {}))
    legacy = dict(sp_data.get("agents", {}))
    tops = [(t["terminal"], tab) for tab in space.get("tabs", []) for t in tab.get("terminals", [])]
    adopted = None  # an earlier per-space link goes to the space's only terminal, if unambiguous
    if legacy and len(tops) == 1 and tops[0][0] not in terms:
        agent = max(legacy, key=lambda a: legacy[a].get("last_used", ""))
        addr, tab = tops[0]
        terms[addr] = dict(legacy.pop(agent), agent=agent, tab=tab.get("id") or "",
                           tab_name=tab.get("name") or "")
        adopted = (addr, agent)
    plan, skipped = [], []
    for addr, e in sorted(terms.items()):
        tab_label = e.get("tab_name") or "?"
        if addr not in here:
            skipped.append((addr, tab_label, e, "terminal no longer exists"))
            continue
        tab, t = here[addr]
        if e.get("tab") and tab.get("id") != e["tab"]:
            skipped.append((addr, tab_label, e, "address now belongs to a different tab"))
        elif t.get("app") or t.get("status"):
            skipped.append((addr, tab_label, e, f"already running {t.get('app') or 'an agent'}"))
        elif _running(e, e["agent"]):
            skipped.append((addr, tab_label, e, "already running"))
        else:
            plan.append((addr, tab.get("name") or tab_label, e))
    return terms, legacy, adopted, plan, skipped


def open_space(query, yes, sid=None):
    ensure_app()
    spaces = herdr_ls()
    with State() as st:
        all_data = st.data
        data = {k: sp for k, sp in st.data.items() if sp.get("terminals") or sp.get("agents")}
    live = {s["id"]: s for s in spaces}
    linked = space_rows(live, data)
    if not linked:
        sys.exit("tether: nothing is linked yet; run `tether claude` or `tether copilot` in a "
                 "herdr terminal first")
    if sid:
        pass
    elif query:
        sid = match_space(query, linked)
        if sid is None:
            names = ", ".join(repr(n) for _, n, _, _ in linked)
            sys.exit(f"tether: no space matches {query!r}. Spaces with links: {names}")
    else:
        choices = space_rows(live, data, openable_only=True)
        if not choices:
            sys.exit("tether: nothing to open: no closed spaces, and every open space's linked "
                     "terminals are already running")
        sid = pick("open space:", [(row_label(n, l), i) for i, n, l, c in choices])
        if sid is None:
            return
    if sid not in live:
        return reopen_closed(sid, data[sid], yes)
    space, name = live[sid], live[sid].get("name") or sid
    terms, legacy, adopted, plan, skipped = plan_space(data[sid], space)
    print(f"space {name!r}")
    for addr, tab_label, e in plan:
        fresh = "" if available(e["agent"], e["session"]) else "  (fresh session: nothing to resume yet)"
        print(f"  {addr:<5} [{tab_label}]  {e['agent']} {e['session'][:8]}  -> resume{fresh}")
    for addr, tab_label, e, why in skipped:
        print(f"  {addr:<5} [{tab_label}]  {e['agent']} {e['session'][:8]}  skipped: {why}")
    for agent in legacy:
        print(f"  (no terminal)  {agent}: earlier link, not tied to a terminal (the space has "
              f"several); run `tether {agent}` in the terminal you want it in")
    if not plan:
        print("nothing to resume")
        return
    if not yes:
        if not sys.stdin.isatty():
            sys.exit("tether: not a terminal; pass -y to type into these terminals")
        if input(f"type `tether resume` into {len(plan)} terminal(s)? [y/N] ").strip().lower() != "y":
            print("cancelled")
            return
    hc = find_tool("hc")
    if not hc:
        sys.exit("tether: hc not found on PATH")
    if adopted and any(a == adopted[0] for a, _, _ in plan):
        with State() as st:  # keep the assignment so the terminal's own `tether` finds it
            sp = st.data.setdefault(sid, {})
            sp.setdefault("terminals", {})[adopted[0]] = terms[adopted[0]]
            sp.setdefault("agents", {}).pop(adopted[1], None)
            st.save()
    me = shutil.which("tether")
    typed = "tether resume" if me else f"'{os.path.realpath(sys.argv[0])}' resume"
    for addr, _, _ in plan:
        r = subprocess.run([hc, "send", addr, typed], capture_output=True, text=True)
        if r.returncode:
            say(f"could not type into {addr}: {(r.stderr or r.stdout).strip()[:200]}")
        else:
            print(f"  sent to {addr}")


# ---------- search ----------
# Tier 1: a local keyword search (free, instant). Tier 2 (--rank): one headless Claude call ranks the
# best candidates from short digests. Tier 3 (--deep): the full text of the top few, one call each.
# Only what was said is ever read: user and assistant text, never tool output or attachments.

STOPWORDS = frozenset(
    "a an and are as at be been by do does did for from had has have how i if in is it its me my of on or "
    "so that the their there this to was we were what when where which who why will with would you your "
    "about find found look looking talked discussed conversation session chat remember remembered thing "
    "things stuff something somewhere".split())
SEARCH_SCOPES = ("open", "closed", "deleted")
SHORT_TERM = 3    # a search term of up to this many characters matches only as a whole word
DIGEST_TOP = 12   # candidates the ranking step sees
DEEP_TOP = 3      # conversations a deep read covers
DEEP_CAP = 60000  # characters of one conversation sent in a deep read


def transcript_file(agent, session, home=None):
    """The one file that holds a session's conversation (under the agent's home, or a backup laid out the same)."""
    if not UUID_RE.match(session or ""):
        return None
    if agent == "claude":
        hits = glob.glob(os.path.join(home or _claude_home(), "projects", "*", session + ".jsonl"))
        return hits[0] if hits else None
    path = os.path.join(home or _copilot_home(), "session-state", session, "events.jsonl")
    return path if os.path.isfile(path) else None


def readable_turns(agent, path):
    """[(role, text)] in order: what the user and the assistant said. No tool output, attachments or
    system reminders."""
    turns = []
    try:
        with open(path, errors="replace") as f:
            for line in f:
                try:
                    e = json.loads(line)
                except ValueError:
                    continue
                t = e.get("type")
                if agent == "claude":
                    if t not in ("user", "assistant") or e.get("isMeta"):
                        continue
                    c = (e.get("message") or {}).get("content")
                    if isinstance(c, list):
                        c = " ".join(p.get("text", "") for p in c if isinstance(p, dict) and p.get("type") == "text")
                    role = t
                else:
                    if t not in ("user.message", "assistant.message"):
                        continue
                    c = (e.get("data") or {}).get("content")
                    role = "user" if t == "user.message" else "assistant"
                c = (c or "").strip() if isinstance(c, str) else ""
                if c and not c.startswith(("<", "Caveat:")):
                    turns.append((role, c))
    except OSError:
        pass
    return turns


def search_corpus(scopes):
    """The conversations to search: [{space_id, space, state, agent, session, tab, last_used, path,
    via_backup}]. open / closed: the sessions of linked spaces, from the agent's own copy or, if the agent
    has swept it, from the backup. deleted: the backup of spaces tether no longer links. A session is
    searched once (a backup of a session of a live space is just another copy of it)."""
    try:
        live = {sp["id"]: sp for sp in herdr_ls()}
    except TetherError:
        live = None
    with State() as st:
        data = {k: v for k, v in st.data.items() if v.get("terminals") or v.get("agents")}
    docs, seen = [], set()

    def add(sid, name, state, e):
        agent = e.get("agent")
        if agent not in AGENTS or not UUID_RE.match(e.get("session") or ""):
            return
        src = source_session(e)
        if (agent, src) in seen:
            return
        path = transcript_file(agent, src)
        via_backup = False
        if not path:
            path = transcript_file(agent, src, os.path.join(backup_dir(), agent))
            via_backup = bool(path)
        if not path:
            return
        seen.add((agent, src))
        docs.append({"space_id": sid, "space": name or sid, "state": state, "agent": agent, "session": e["session"],
                     "src": src, "tab": e.get("tab_name") or "", "last_used": e.get("last_used") or "",
                     "path": path, "via_backup": via_backup, "cwd": e.get("cwd") or ""})

    for sid, sp, _addr, e in all_links(data):
        state = "open" if live is not None and sid in live else "closed"
        if state in scopes:
            add(sid, (live[sid].get("name") if state == "open" else None) or sp.get("name"), state, e)
    if "deleted" in scopes:
        for r in deleted_spaces():
            for l in r["links"]:
                add(r["id"], r["name"], "deleted", dict(l, last_used=r["backed_up"]))
    return docs


def query_terms(query):
    # "Acme's" is Acme, not Acme and "s": a possessive is dropped, and so is any one-letter leftover, because a
    # term of one letter matches inside nearly every word and drowns the words that were meant.
    text = re.sub(r"['’]s\b", "", query.lower())
    words = re.findall(r"[a-z0-9][a-z0-9_.\-/]*[a-z0-9]|[a-z0-9]", text)
    return list(dict.fromkeys([w for w in words if w not in STOPWORDS and len(w) > 1] or words))


@functools.lru_cache(maxsize=256)
def _term_re(term):
    """How a search term is found in lower-case text. A longer term matches inside words ("investig" finds
    "investigation"); one of up to three characters ("us", "api") only as a whole word, or "us" would match
    "status" and "business". The web mod highlights with the same rule (pieces() in tether-search)."""
    body = re.escape(term)
    return re.compile(body if len(term) > SHORT_TERM else rf"(?<![a-z0-9]){body}(?![a-z0-9])")


def _snippet(text, terms, width=260):
    low = text.lower()
    hits = [m.start() for m in (_term_re(t).search(low) for t in terms) if m]
    i = min(hits) if hits else 0
    start = max(0, i - 90)
    return ("…" if start else "") + " ".join(text[start:start + width].split()) + ("…" if start + width < len(text) else "")


def lexical_rank(terms, docs, limit=15):
    """Tier 1. Rows for the conversations that match, best first. A term counts as a substring (so
    "investig" finds "investigation"), rarer terms weigh more, words the user typed count extra, and
    the whole query or two terms in a row as a phrase count more. score is 0..100."""
    n = len(docs)
    scored = []
    df = collections.Counter()
    for d in docs:
        turns = readable_turns(d["agent"], d["path"])
        low = [(role, t.lower()) for role, t in turns]
        tf = {w: sum(len(_term_re(w).findall(x)) for _, x in low) for w in terms}
        tfu = {w: sum(len(_term_re(w).findall(x)) for role, x in low if role == "user") for w in terms}
        for w in terms:
            if tf[w]:
                df[w] += 1
        scored.append((d, turns, low, tf, tfu))
    rows = []
    phrase = " ".join(terms)
    pairs = [" ".join(terms[i:i + 2]) for i in range(len(terms) - 1)]
    for d, turns, low, tf, tfu in scored:
        idf = {w: math.log(1 + n / (1 + df[w])) for w in terms}
        score = sum(idf[w] * (1 + math.log(tf[w])) for w in terms if tf[w])
        score += sum(0.5 * idf[w] * (1 + math.log(tfu[w])) for w in terms if tfu[w])
        joined = "\n".join(x for _, x in low)
        if len(terms) > 1 and phrase in joined:
            score += 2 * sum(idf.values())
        score += sum(0.5 * sum(idf[w] for w in p.split()) for p in pairs if p in joined)
        if score <= 0:
            continue
        # A conversation with all the words ranks above one with a few of them, however often they come up there.
        score *= sum(1 for w in terms if tf[w]) / len(terms)
        ranked_turns = sorted(range(len(low)), key=lambda i: -sum(1 for w in terms if _term_re(w).search(low[i][1])))
        snippets = [{"role": turns[i][0], "text": _snippet(turns[i][1], terms)}
                    for i in ranked_turns[:3] if any(_term_re(w).search(low[i][1]) for w in terms)]
        rows.append(dict(d, score=score, snippets=snippets, chars=sum(len(t) for _, t in turns), _turns=turns))
    rows.sort(key=lambda r: -r["score"])
    top = rows[0]["score"] if rows else 1
    for r in rows:
        r["score"] = round(100 * r["score"] / top)
        r["title"] = session_title(r["agent"], r["src"])
    return rows[:limit]


def recent_rows(docs, limit=DIGEST_TOP):
    """Candidates when no keyword matched: the most recently used conversations, for the AI step to judge."""
    rows = []
    for d in sorted(docs, key=lambda d: d["last_used"], reverse=True)[:limit]:
        turns = readable_turns(d["agent"], d["path"])
        rows.append(dict(d, score=0, snippets=[], chars=sum(len(t) for _, t in turns), _turns=turns,
                         title=session_title(d["agent"], d["src"])))
    return rows


def _digest(i, r):
    turns = r.get("_turns") or readable_turns(r["agent"], r["path"])
    users = [t for role, t in turns if role == "user"]
    firsts, lasts = users[:2], [u for u in users[-2:] if u not in users[:2]]
    lines = [f"[{i}] space: {r['space']}  tab: {r['tab'] or '-'}  ({r['state']}, {r['agent']}, last used {r['last_used'][:10] or '?'})",
             f"    first asked: " + " | ".join(_clean(u, 200) for u in firsts)]
    if lasts:
        lines.append("    last asked: " + " | ".join(_clean(u, 200) for u in lasts))
    for sn in r["snippets"]:
        lines.append(f"    matched ({sn['role']}): {sn['text']}")
    return "\n".join(lines)


def search_estimate(rows, corpus, model):
    """What the AI steps would cost, in tokens (about 4 characters each), for these results."""
    digests = sum(len(_digest(i, r)) for i, r in enumerate(rows[:DIGEST_TOP], 1))
    deep = sum(min(r["chars"], DEEP_CAP) for r in rows[:DEEP_TOP])
    return {"corpus_sessions": corpus, "rank_candidates": min(len(rows), DIGEST_TOP), "rank_tokens": digests // 4 + 500,
            "deep_sessions": min(len(rows), DEEP_TOP), "deep_tokens": deep // 4 + 400 * min(len(rows), DEEP_TOP),
            "model": model}


def search_model():
    return env("SEARCH_MODEL") or load_config().get("search_model") or "sonnet"


def ask_claude(prompt, model, budget=2):
    """One headless Claude call; the prompt goes in on stdin (nothing is written to disk) and the call has no
    tools at all. -> (answer text, cost in USD or None)"""
    binary = find_tool("claude")
    if not binary:
        raise TetherError("claude not found on PATH: the AI steps need it")
    cmd = [binary, "-p", "--tools", "", "--no-session-persistence", "--disable-slash-commands",
           "--model", model, "--output-format", "json", "--max-budget-usd", str(budget)]
    try:
        # No claude.ai connectors (Slack, Gmail, Linear, ...): a headless call never needs them, they were ~170k tokens of tool definitions
        # loaded on every call (a trivial sonnet turn cost $0.78, now $0.11), and a session that cannot see them cannot misuse them.
        r = subprocess.run(cmd, input=prompt, capture_output=True, text=True, timeout=300,
                           cwd=home_dir_setting() or os.path.expanduser("~"),
                           env=dict(os.environ, ENABLE_CLAUDEAI_MCP_SERVERS="false"))
    except (subprocess.SubprocessError, OSError) as err:
        raise TetherError(f"the AI step failed ({type(err).__name__})")
    try:
        data = json.loads(r.stdout)
    except ValueError:
        # claude refused to start (policy, login, bad flag): its message is on stderr
        raise TetherError("the AI step failed: " + (r.stderr or r.stdout or f"exit {r.returncode}").strip()[:200])
    if r.returncode or data.get("is_error") or not isinstance(data.get("result"), str):
        raise TetherError("the AI step failed: " + str(data.get("result") or r.stderr).strip()[:200])
    return data["result"], data.get("total_cost_usd")


def parse_json_answer(text):
    m = re.search(r"(\[.*\]|\{.*\})", text, re.S)
    try:
        return json.loads(m.group(1))
    except (AttributeError, ValueError):
        raise TetherError("the AI's answer was not valid JSON; try again")


def rank_with_ai(query, rows, model):
    """Tier 2: re-rank the top candidates from their digests. -> (rows, cost)"""
    cands = rows[:DIGEST_TOP]
    prompt = (f"You rank past conversations for a search. The user is looking for:\n  {query}\n\n"
              f"Below are {len(cands)} candidate conversations (digests only). Judge which one the user most likely means. "
              'Reply with ONLY a JSON array, best first: [{"id": <number>, "score": <0-100>, "why": "<one short sentence>"}]. '
              "Give a low score (0-10) to ones that clearly do not match. Use only the digests.\n\n"
              + "\n\n".join(_digest(i, r) for i, r in enumerate(cands, 1)))
    text, cost = ask_claude(prompt, model)
    answer = parse_json_answer(text)
    by_id = {}
    for a in answer if isinstance(answer, list) else []:
        try:
            by_id[int(a["id"])] = a
        except (KeyError, TypeError, ValueError):
            continue
    for i, r in enumerate(cands, 1):
        a = by_id.get(i)
        r["keyword_score"] = r["score"]
        r["score"] = max(0, min(100, int(a.get("score", 0)))) if a else 0
        r["why"] = str(a.get("why", ""))[:300] if a else ""
    cands.sort(key=lambda r: -r["score"])
    return cands + rows[DIGEST_TOP:], cost


def deep_read(query, rows, model):
    """Tier 3: the full text of each given row, one Claude call each, in parallel. -> (rows, cost)"""
    def one(r):
        turns = r.get("_turns") or readable_turns(r["agent"], r["path"])
        text = "\n".join(f"{role.upper()}: {t}" for role, t in turns)
        if len(text) > DEEP_CAP:
            text = text[:DEEP_CAP // 2] + "\n[... middle left out ...]\n" + text[-DEEP_CAP // 2:]
        prompt = (f"The user is looking for a past conversation:\n  {query}\n\nHere is one conversation (what was said; "
                  'tool output left out). Does it match? Reply with ONLY JSON: {"score": <0-100>, "why": "<one short sentence>", '
                  '"quote": "<a short verbatim passage from it that matches, or empty>"}\n\n' + text)
        out, cost = ask_claude(prompt, model)
        return r, parse_json_answer(out), cost
    total, done = 0.0, []
    with concurrent.futures.ThreadPoolExecutor(max_workers=DEEP_TOP) as pool:
        for r, a, cost in pool.map(one, rows):
            r["keyword_score"] = r.get("keyword_score", r["score"])
            r["score"] = max(0, min(100, int(a.get("score", 0)))) if isinstance(a, dict) else 0
            r["why"] = str(a.get("why", ""))[:300] if isinstance(a, dict) else ""
            r["quote"] = str(a.get("quote", ""))[:300] if isinstance(a, dict) else ""
            total += cost or 0
            done.append(r)
    done.sort(key=lambda r: -r["score"])
    return done, total


READ_CAP = 30000   # characters printed at most
READ_MESSAGE = 1500  # one message is cut here unless --full


def read_cmd(args):
    """tether read <space> [--last N] [--commands] [--full] [--id X | --session S] [--json]: what a space's conversation said."""
    flags, vals, words = parse_opts(args, flags=("--commands", "--full", "--json"), valued=("--last", "--id", "--session"))
    try:
        last = max(1, int(vals.get("--last") or 12))
    except ValueError:
        sys.exit("tether: --last takes a number")
    if not words and not vals.get("--id") and not vals.get("--session"):
        sys.exit("usage: tether read <space name> [--last N] [--commands] [--full] [--id <space-id> | --session <id>] [--json]")
    convs = find_conversations(words, vals.get("--id"), vals.get("--session"))
    out = []
    for c in convs:
        msgs = conversation_text(c["agent"], c["path"], as_lines=True)
        if "--commands" not in flags:
            msgs = [m for m in msgs if not m.startswith("COMMAND: ")]
        total = len(msgs)
        shown = msgs[-last:]
        if "--full" not in flags:
            shown = [m if len(m) <= READ_MESSAGE else m[:READ_MESSAGE] + " [cut]" for m in shown]
        out.append({"space": c["space"], "state": c.get("state"), "agent": c["agent"], "session": c["session"], "tab": c.get("tab"),
                    "last_used": c.get("last_used"), "messages_total": total, "messages": shown})
    if "--json" in flags:
        print(json.dumps(out, indent=2))
        return
    budget = READ_CAP
    for c in out:
        head = f"=== {c['space']} ({c['agent']} session {c['session'][:8]}, last {len(c['messages'])} of {c['messages_total']} messages) ==="
        print(head)
        body = "\n".join(c["messages"])
        if len(body) > budget:
            body = "[older part left out]\n" + body[-budget:]
        budget = max(0, budget - len(body))
        print(body + "\n")
    say("what was said only, never tool output; summarise it for the user rather than pasting it, it can hold personal data or secrets.")


def search_cmd(args):
    flags, vals, words = parse_opts(args, flags=("--rank", "--deep", "--json"), valued=("--scope", "--limit", "--sessions"))
    query = " ".join(words).strip()
    if not query:
        sys.exit("usage: tether search <words or a question> [--scope open,closed,deleted] [--rank] [--deep] [--json]")
    scopes = [x for x in (vals.get("--scope") or "open,closed").split(",") if x]
    bad = [x for x in scopes if x not in SEARCH_SCOPES]
    if bad or not scopes:
        sys.exit(f"tether: --scope takes {', '.join(SEARCH_SCOPES)} (comma separated), not {bad or 'nothing'}")
    try:
        limit = int(vals.get("--limit") or 15)
    except ValueError:
        sys.exit("tether: --limit takes a number")
    model, cost, tier = search_model(), None, 1
    docs = search_corpus(scopes)
    terms = query_terms(query)
    rows = lexical_rank(terms, docs, limit)
    fallback = False
    estimate = search_estimate(rows if rows else recent_rows(docs), len(docs), model)
    estimate["no_keyword_match"] = not rows
    if not rows and ("--rank" in flags or "--deep" in flags):
        rows, fallback = recent_rows(docs), True  # nothing matched the words: let the AI judge the recent ones
    wanted = [x for x in (vals.get("--sessions") or "").split(",") if x]
    if "--rank" in flags and rows:
        rows, cost = rank_with_ai(query, rows, model)
        tier = 2
    if "--deep" in flags and rows:
        targets = [r for r in rows if r["session"] in wanted or r["src"] in wanted] if wanted else rows[:DEEP_TOP]
        if targets:
            deep, c = deep_read(query, targets, model)
            cost = (cost or 0) + c
            rest = [r for r in rows if r not in targets]
            rows, tier = sorted(deep + rest, key=lambda r: (r in rest, -r["score"])), 3
    out = [{k: v for k, v in r.items() if not k.startswith("_") and k not in ("path", "chars")} for r in rows]
    if "--json" in flags:
        print(json.dumps({"query": query, "terms": terms, "scopes": scopes, "tier": tier, "model": model, "cost_usd": cost,
                          "corpus": len(docs), "estimate": estimate, "fallback": fallback, "results": out}))
        return
    if not out:
        print(f"no keyword match in {len(docs)} conversation(s) of {', '.join(scopes)} spaces"
              + (f"; --rank would look at your {estimate['rank_candidates']} most recent ones (about {estimate['rank_tokens']:,} tokens)"
                 if docs else ""))
        return
    for r in out:
        print(f"{r['score']:>3}  {r['space']} / {r['tab'] or '-'}  [{r['state']}, {r['agent']}]  {ago(r['last_used']) if r['last_used'] else ''}")
        print(f"     {r['title'] or '(no first message found)'}")
        if r.get("why"):
            print(f"     why: {r['why']}")
        if r.get("quote"):
            print(f"     “{r['quote']}”")
        elif r["snippets"]:
            print(f"     {r['snippets'][0]['role']}: {r['snippets'][0]['text']}")
    print(f"{len(out)} of {len(docs)} conversation(s)"
          + (f"; AI cost ${cost:.3f}" if cost else f"; --rank would use about {estimate['rank_tokens']:,} tokens, "
             f"--deep about {estimate['deep_tokens']:,} ({model})"))


def _terminal_of_pid(pid):
    """The herdr terminal a process runs in (its HC_TERMINAL_ID), or None."""
    r = subprocess.run(["ps", "eww", "-p", str(pid)], capture_output=True, text=True)
    m = re.search(r"HC_TERMINAL_ID=(\S+)", r.stdout)
    return m.group(1) if m else None


def running_agents():
    """[{agent, pid, terminal, session, cwd}] for every Claude / Copilot process that runs inside a
    herdr terminal and whose session can be read: Claude from ~/.claude/sessions/<pid>.json,
    Copilot from its session folder's inuse.<pid>.lock."""
    found = []
    out = subprocess.run(["ps", "-axo", "pid=,comm="], capture_output=True, text=True).stdout
    for line in out.splitlines():
        parts = line.split(None, 1)
        if len(parts) < 2 or not parts[0].isdigit():
            continue
        pid, base = int(parts[0]), os.path.basename(parts[1])
        agent = "claude" if base == "claude" else "copilot" if base == "copilot" else None
        if not agent:
            continue
        term = _terminal_of_pid(pid)
        if not term:
            continue
        session = cwd = None
        if agent == "claude":
            try:
                with open(os.path.join(_claude_home(), "sessions", f"{pid}.json")) as f:
                    info = json.load(f)
                session, cwd = info.get("sessionId"), info.get("cwd")
            except (OSError, ValueError):
                pass
        else:
            locks = glob.glob(os.path.join(_copilot_home(), "session-state", "*", f"inuse.{pid}.lock"))
            if locks:
                lock = max(locks, key=lambda p: os.path.getmtime(p))
                session = os.path.basename(os.path.dirname(lock))
                try:
                    with open(os.path.join(os.path.dirname(lock), "workspace.yaml")) as f:
                        m = re.search(r"^cwd:\s*(.+)$", f.read(), re.M)
                    cwd = m.group(1).strip().strip("'\"") if m else None
                except OSError:
                    pass
        if session and UUID_RE.match(session):
            found.append({"agent": agent, "pid": pid, "terminal": term, "session": session, "cwd": cwd})
    return found


def sync_names(data, live, only=None):
    """Copy the current names of live spaces and tabs into the links tether keeps for them, so a rename
    made in Herdr is not lost: a closed space is shown, and reopened, under the name it last had. Only
    spaces that already have links; returns True if anything changed."""
    changed = False
    for s in live:
        rec = data.get(s.get("id"))
        if (only and s.get("id") != only) or not isinstance(rec, dict) or not (rec.get("terminals") or rec.get("agents")):
            continue
        if s.get("name") and rec.get("name") != s["name"]:
            rec["name"], changed = s["name"], True
        tabs = {t.get("id"): t.get("name") for t in s.get("tabs", [])}
        for term in (rec.get("terminals") or {}).values():
            if tabs.get(term.get("tab")) and term.get("tab_name") != tabs[term["tab"]]:
                term["tab_name"], changed = tabs[term["tab"]], True
    return changed


def adopt(space_id=None):
    """Link agents running in herdr terminals that tether does not know yet (never changes a link
    that exists), and keep the stored space and tab names current. Returns [(space name, tab name,
    agent, session)] for what it linked."""
    live = herdr_ls()
    adopted = []
    with State() as st:
        renamed = sync_names(st.data, live, space_id)
        for r in running_agents():
            hit = find_terminal(live, r["terminal"])
            if not hit:
                continue
            sp, tab, t = hit
            if space_id and sp["id"] != space_id:
                continue
            rec = st.data.setdefault(sp["id"], {})
            terms = rec.setdefault("terminals", {})
            rec.setdefault("agents", {})
            if t["terminal"] in terms:
                continue
            if any(e.get("session") == r["session"] and e.get("agent") == r["agent"]
                   for _, _, _, e in all_links(st.data)):
                continue  # this session is linked somewhere already
            rec["name"] = sp.get("name") or rec.get("name") or sp["id"]
            terms[t["terminal"]] = {
                "agent": r["agent"], "session": r["session"],
                "cwd": r["cwd"] if r["cwd"] and os.path.isdir(r["cwd"]) else os.getcwd(),
                "tab": tab.get("id") or "", "tab_name": tab.get("name") or "",
                "created": now(), "last_used": now(), "pid": r["pid"], "pid_started": _started(r["pid"])}
            adopted.append((rec["name"], tab.get("name") or "", r["agent"], r["session"]))
        if adopted or renamed:
            st.save()
    return adopted


def adopt_cmd(args):
    _, vals, _ = parse_opts(args, flags=("--json",), valued=("--id",))
    ensure_app()
    got = adopt(vals.get("--id"))
    if "--json" in args:
        print(json.dumps([{"space": a, "tab": b, "agent": c, "session": d} for a, b, c, d in got]))
        return
    for space, tab, agent, session in got:
        print(f"linked {agent} {session[:8]} in {space!r} [{tab or '?'}]")
    print(f"{len(got)} agent(s) linked" if got else "nothing to link: every running agent is linked already")


def safe_adopt(space_id=None):
    """adopt() for background use: never raises, does nothing when Herdr is not running or
    TETHER_NO_ADOPT=1. Returns what it linked."""
    if env("NO_ADOPT"):
        return []
    try:
        return adopt(space_id)
    except (TetherError, OSError, subprocess.SubprocessError, ValueError):
        return []


def copy_copilot_session(src_id, dst_id):
    """Copy a Copilot session folder under a new id: the folder name is what Copilot goes by, and the
    ids written inside are rewritten so the copy is consistent. Locks of a running copy are dropped."""
    root = os.path.join(_copilot_home(), "session-state")
    src, dst = os.path.join(root, src_id), os.path.join(root, dst_id)
    if not os.path.isdir(src):
        raise TetherError(f"copilot session {src_id} not found")
    shutil.copytree(src, dst, symlinks=True)
    for name in os.listdir(dst):
        if name.startswith("inuse.") and name.endswith(".lock"):
            os.remove(os.path.join(dst, name))
    for name in ("workspace.yaml", "events.jsonl"):
        path = os.path.join(dst, name)
        if os.path.isfile(path):
            with open(path, encoding="utf-8") as f:
                text = f.read()
            with open(path, "w", encoding="utf-8") as f:
                f.write(text.replace(src_id, dst_id))


def fork_name(base, taken):
    base = re.sub(r"\s*\(fork(?: \d+)?\)$", "", base) or base  # a fork of a fork is numbered like its siblings
    for n in range(1, 100):
        cand = f"{base} (fork)" if n == 1 else f"{base} (fork {n})"
        if norm_name(cand) not in taken:
            return cand
    raise TetherError("too many forks of this space; rename or delete some")


def fork_space(args):
    """Copy a space: a new space whose tabs continue copies of the original's sessions."""
    _, vals, words = parse_opts(args, flags=("-y", "--yes"), valued=("--id",))
    yes = "-y" in args or "--yes" in args
    ensure_app()
    live_list = herdr_ls()
    live = {sp["id"]: sp for sp in live_list}
    with State() as st:
        data = {k: v for k, v in st.data.items() if v.get("terminals") or v.get("agents")}
    rows = space_rows(live, data)
    sid = vals.get("--id")
    if not sid:
        if words:
            sid = match_space(" ".join(words), rows)
            if sid is None:
                sys.exit(f"tether: no space matches {' '.join(words)!r}")
        else:
            sid = pick("fork which space?", [(row_label(n, l), i) for i, n, l, c in rows])
            if sid is None:
                return
    if sid in live:  # agents started without tether are linked first, or they would be left out
        try:
            for space, tab, agent, session in adopt(sid):
                print(f"  linked {agent} {session[:8]} in [{tab or '?'}] (it was not linked to tether yet)")
        except (TetherError, OSError) as err:
            say(f"could not look for unlinked agents ({err})")
        with State() as st:
            data = {k: v for k, v in st.data.items() if v.get("terminals") or v.get("agents")}
    if sid not in data:
        sys.exit(f"tether: tether has nothing linked for space {sid!r}")
    sp = data[sid]
    name = (live[sid].get("name") if sid in live else None) or sp.get("name") or sid
    links = [(addr, e) for _, _, addr, e in all_links({sid: sp})]
    print(f"forking {name!r}")
    # make sure the original is safe first, and that every transcript we copy exists
    try:
        with contextlib.redirect_stdout(io.StringIO()):
            backup_cmd(["--id", sid, "--quiet"])
    except (SystemExit, TetherError, OSError) as err:
        say(f"could not back up first ({err}); continuing, the original is not modified")
    plan = []
    for addr, e in sorted(links, key=lambda x: x[0] or ""):
        if not session_exists(e["agent"], e["session"]):
            restore_session(e["agent"], e["session"])
        tab = e.get("tab_name") or e["agent"]
        src = e.get("fork_of")
        if not session_exists(e["agent"], e["session"]) and src and session_exists(e["agent"], src):
            # a fork nobody has typed in yet has no transcript of its own, but it shows (and is) a copy
            # of the session it was forked from: fork that one
            print(f"  [{tab}] {e['agent']} {e['session'][:8]}  -> copied from the session it was forked from "
                  f"({src[:8]}); nothing has been said in this tab yet")
            plan.append((addr, dict(e, session=src)))
        elif not session_exists(e["agent"], e["session"]):
            print(f"  [{tab}] {e['agent']} {e['session'][:8]}  skipped: no conversation to copy "
                  f"(nothing has been said in this tab yet)")
        else:
            running = " (running now: copied as it is at this moment)" if _running(e, e["agent"]) else ""
            print(f"  [{tab}] {e['agent']} {e['session'][:8]}  -> copied{running}")
            plan.append((addr, e))
    if not plan:
        sys.exit("tether: nothing to fork: no linked session has a conversation yet")
    taken = {norm_name(x.get("name") or "") for x in live_list}
    taken |= {norm_name(x.get("name") or "") for x in data.values()}
    new_name = fork_name(name, taken)
    if not yes:
        if not sys.stdin.isatty():
            sys.exit("tether: not a terminal; pass -y to fork")
        if input(f"create {new_name!r} with {len(plan)} tab(s)? [y/N] ").strip().lower() != "y":
            print("cancelled")
            return
    if not find_tool("hc"):
        raise TetherError("hc not found on PATH")
    new_space, created = None, []
    try:
        for addr, e in plan:
            folder = e.get("cwd") if e.get("cwd") and os.path.isdir(e["cwd"]) else os.getcwd()
            tab = e.get("tab_name") or ""
            if new_space is None:
                args2 = ["space.new", "--name", new_name, "--folder", folder] + (["--tab", tab] if tab else [])
            else:
                args2 = ["tab.new", "--space", new_space, "--folder", folder] + (["--name", tab] if tab else [])
            made = herdr_do(args2)
            if not made.get("terminal"):
                raise TetherError(f"herdr-app did not return a terminal for {tab or e['agent']!r}")
            new_space = new_space or made.get("space")
            new_id = str(uuid4())
            link_new = {"agent": e["agent"], "session": new_id, "cwd": e.get("cwd") or folder, "tab_name": tab,
                        "created": now(), "last_used": now()}
            if e["agent"] == "claude":
                link_new["fork_of"] = e["session"]  # Claude forks lazily on first start (--fork-session)
            else:
                copy_copilot_session(e["session"], new_id)
            created.append((made["terminal"], link_new))
    except (TetherError, OSError) as err:
        say(str(err))
    if not created:
        raise TetherError("could not create the forked space")
    now_live = herdr_ls()
    with State() as st:
        if not new_space:
            hit = find_terminal(now_live, created[0][0])
            new_space = hit[0]["id"] if hit else None
        if not new_space:
            raise TetherError("created terminals but could not tell which space they are in")
        rec = st.data.setdefault(new_space, {})
        rec["name"] = new_name
        rec["forked_from"] = {"name": name, "id": sid, "at": now()}
        rec.setdefault("agents", {})
        terms = rec.setdefault("terminals", {})
        for term, link_new in created:
            hit = find_terminal(now_live, term)
            terms[term] = dict(link_new, tab=(hit[1].get("id") if hit else "") or "")
        st.save()
    for term, link_new in created:
        r = subprocess.run([find_tool("hc"), "send", term, f"{tether_cmd()} resume"], capture_output=True, text=True)
        if r.returncode:
            say(f"could not type into {term}: {(r.stderr or r.stdout).strip()[:200]}")
        else:
            print(f"  {term} [{link_new['tab_name'] or link_new['agent']}]: starting {link_new['agent']} (fork)")
    print(f"created {new_name!r}; {name!r} is unchanged")


def open_session(args):
    """Put one session back in a new tab of the space that linked it."""
    _, vals, words = parse_opts(args, valued=("--agent",))
    session = words[0] if words else None
    if not session or not UUID_RE.match(session):
        sys.exit("usage: tether open-session <session-id> [--agent claude|copilot]")
    with State() as st:
        hits = [(sid, sp, addr, e) for sid, sp, addr, e in all_links(st.data)
                if e["session"] == session and vals.get("--agent") in (None, e["agent"])]
    if not hits:  # maybe its space was deleted: the backup still knows it
        gone = next((r for r in deleted_spaces() if any(l["session"] == session for l in r["links"])), None)
        if gone:
            print(f"bringing back the deleted space {gone['name']!r}")
            undelete_space(gone)
            with State() as st:
                hits = [(sid, sp, addr, e) for sid, sp, addr, e in all_links(st.data)
                        if e["session"] == session and vals.get("--agent") in (None, e["agent"])]
    if not hits:
        sys.exit(f"tether: no space links session {session}; restore it with "
                 f"`tether restore --session {session}` and resume it by hand")
    sid, sp, addr, e = hits[0]
    agent = e["agent"]
    ensure_app()
    live = {s["id"]: s for s in herdr_ls()}
    src = source_session(e)
    if not session_exists(agent, src):
        if not restore_session(agent, src):
            print(f"no transcript for {src[:8]} anywhere; it will start fresh")
        else:
            print(f"restored {agent} session {src[:8]} from the backup")
    if sid not in live:
        return reopen_closed(sid, sp, True)
    if running_link({sid: sp}, session, agent):
        print(f"{agent} session {session[:8]} is already running in this space")
        return
    folder = e.get("cwd") if e.get("cwd") and os.path.isdir(e["cwd"]) else os.getcwd()
    tab_name = e.get("tab_name") or ""
    made = herdr_do(["tab.new", "--space", sid, "--folder", folder] + (["--name", tab_name] if tab_name else []))
    term = made.get("terminal")
    if not term:
        raise TetherError("herdr-app did not return a terminal for the new tab")
    hit = find_terminal(herdr_ls(), term)
    with State() as st:
        space = st.data.setdefault(sid, {})
        terms = space.setdefault("terminals", {})
        if addr and addr in terms and terms[addr].get("session") == session:
            terms.pop(addr)  # the old terminal's link moves to the new tab
        space.setdefault("agents", {})
        terms[term] = dict(e, agent=agent, tab=(hit[1].get("id") if hit else "") or "",
                           tab_name=tab_name, last_used=now())
        st.save()
    hc = find_tool("hc")
    if not hc:
        raise TetherError("hc not found on PATH")
    r = subprocess.run([hc, "send", term, f"{tether_cmd()} resume"], capture_output=True, text=True)
    if r.returncode:
        raise TetherError(f"could not type into {term}: {(r.stderr or r.stdout).strip()[:200]}")
    print(f"resuming {agent} session {session[:8]} in a new tab of {sp.get('name') or sid!r}")


def doctor(args):
    """Checks the install, Herdr, links and backups. Returns the list of problems."""
    results = []  # (level, text, fix)   level: ok | warn | bad

    def add(level, text, fix=""):
        results.append((level, text, fix))

    for tool in ("herdr-app", "hc"):
        add("ok" if find_tool(tool) else "bad", f"{tool} found" if find_tool(tool) else f"{tool} not found",
            "" if find_tool(tool) else "install Herdr: curl -fsSL https://releases.herdr.dev/app/install.sh | sh")
    for agent in AGENTS:
        add("ok" if find_tool(agent) else "warn", f"{agent} found" if find_tool(agent) else f"{agent} not found",
            "" if find_tool(agent) else f"install {agent} if you use it")
    here = shutil.which("tether")
    add("ok" if here else "warn", "tether is on PATH" if here else "tether is not on PATH",
        "" if here else "add ~/.local/bin to PATH (Herdr's `tether resume` typing needs it)")

    live = None
    try:
        if find_tool("herdr-app"):
            live = {s["id"]: s for s in herdr_ls()}
    except Exception:  # noqa: BLE001 - any failure just means "not running"
        live = None
    add("ok" if live is not None else "warn", "Herdr is running" if live is not None else "Herdr is not running",
        "" if live is not None else "start it: herdr-app (some checks below are skipped)")

    mods = os.path.expanduser("~/.config/herdr-app/mods")
    missing = [m for m in ("tether-spaces", "tether-new-space", "tether-history", "tether-menu",
                           "tether-backups", "tether-search", "tether-tabs", "tether-new-menu")
               if not os.path.isfile(os.path.join(mods, m, "main.js"))]
    add("ok" if not missing else "warn", "Herdr mods installed" if not missing else f"missing mods: {', '.join(missing)}",
        "" if not missing else "re-run ./install.sh from the tether folder (with Herdr quit)")
    skill = os.path.join(_claude_home(), "skills", "tether", "SKILL.md")
    add("ok" if os.path.isfile(skill) else "warn", "agent skill installed" if os.path.isfile(skill) else "agent skill missing",
        "" if os.path.isfile(skill) else "re-run ./install.sh")

    with State() as st:
        data = {k: v for k, v in st.data.items() if v.get("terminals") or v.get("agents")}
    links = list(all_links(data))
    add("ok", f"{len(data)} linked space(s), {len(links)} link(s)")
    legacy = [sp.get("name") or sid for sid, sp, addr, _ in links if addr is None]
    if legacy:
        add("warn", f"{len(set(legacy))} space(s) still use the old per-space link: {', '.join(sorted(set(legacy)))}",
            "run `tether claude` (or copilot) once in each space's terminal to convert it")
    gone = recoverable = 0
    for sid, sp, addr, e in links:
        if not session_exists(e["agent"], source_session(e)):
            if has_backup(e["agent"], source_session(e)):
                recoverable += 1
            else:
                gone += 1
    if recoverable:
        add("warn", f"{recoverable} linked transcript(s) gone from the agent but in the backup", "tether restore")
    if gone:
        add("warn", f"{gone} linked session(s) have no transcript anywhere (never used, or cleaned up before a backup)",
            "harmless: they start fresh. `tether reset` unlinks them.")
    if live is not None:
        stale = [(sp.get("name") or sid, addr) for sid, sp, addr, _ in links
                 if addr and sid in live and not find_terminal([live[sid]], addr)]
        if stale:
            add("warn", f"{len(stale)} link(s) point at terminals that no longer exist: "
                + ", ".join(f"{n}/{a}" for n, a in stale[:5]), "`tether open <space>` skips them; `tether reset` in the space clears it")
    if live is not None:
        try:
            unlinked = [r for r in running_agents() if (lambda h: h and h[2]["terminal"] not in
                        data.get(h[0]["id"], {}).get("terminals", {}))(find_terminal(list(live.values()), r["terminal"]))]
        except (TetherError, OSError):
            unlinked = []
        if unlinked:
            add("warn", f"{len(unlinked)} agent(s) run in Herdr tabs without a tether link (started with plain "
                f"`claude`/`copilot`): they will not survive a restart and `fork` would skip them", "tether adopt")
    names = {}
    for sid, sp in data.items():
        names.setdefault(norm_name(sp.get("name") or sid), []).append(sid)
    dup = [n for n, ids in names.items() if len(ids) > 1]
    if dup:
        add("warn", f"duplicate space names: {', '.join(dup)}", "`tether delete <space>` the extra one")

    bs = backup_status(data)
    add("ok" if bs["exists"] else "warn", f"backup folder {bs['dir']}" if bs["exists"] else "no backup yet",
        "" if bs["exists"] else "run `tether backup`")
    if bs["exists"]:
        stale = bs["linked"] - bs["backed_up"] - bs["missing"]
        if stale > 0:
            add("warn", f"{stale} linked session(s) not backed up yet", "tether backup")
    add("ok" if bs["auto"] else "warn", "automatic backup on" if bs["auto"] else "automatic backup off",
        "" if bs["auto"] else 'enable: set "auto": true in ' + config_path())
    try:
        with open(os.path.join(_claude_home(), "settings.json")) as f:
            keep = json.load(f).get("cleanupPeriodDays")
    except (OSError, ValueError):
        keep = None
    if keep is None:
        add("warn", "Claude deletes transcripts after its default 30 days",
            'raise it: "cleanupPeriodDays": 365 in ~/.claude/settings.json')
    else:
        add("ok", f"Claude keeps transcripts for {keep} days")
    return results


def doctor_cmd(args):
    results = doctor(args)
    bad = [r for r in results if r[0] != "ok"]
    if "--json" in args:
        print(json.dumps([{"level": l, "text": t, "fix": f} for l, t, f in results], indent=2))
    else:
        mark = {"ok": "ok  ", "warn": "warn", "bad": "FAIL"}
        for level, text, fix in results:
            print(f"  {mark[level]}  {text}")
            if fix and level != "ok":
                print(f"        -> {fix}")
        print("all good" if not bad else f"{len(bad)} thing(s) need attention")
    if any(r[0] == "bad" for r in results):
        sys.exit(1)


UUID_RE = re.compile(r"^[0-9a-fA-F]{8}(-[0-9a-fA-F]{4}){3}-[0-9a-fA-F]{12}$")


def session_paths(agent, session, home=None):
    """Everything on disk that belongs to one session (only ever keyed by its uuid), under the
    agent's own folder or, with `home`, under a folder laid out the same way (a backup)."""
    if not UUID_RE.match(session or ""):
        return []
    if agent == "claude":
        home = home or _claude_home()
        found = glob.glob(os.path.join(home, "projects", "*", session + ".jsonl"))
        found += glob.glob(os.path.join(home, "projects", "*", session))
        found += [os.path.join(home, "file-history", session), os.path.join(home, "session-env", session)]
    else:
        found = [os.path.join(home or _copilot_home(), "session-state", session)]
    return [f for f in found if os.path.lexists(f)]


def _remove(path):
    if os.path.isdir(path) and not os.path.islink(path):
        shutil.rmtree(path)
    else:
        os.remove(path)


def close_space_and_wait(sid, links, timeout=8.0):
    """Close a space in Herdr, then wait until it is gone and none of its sessions is still running
    (instead of a fixed pause), so their files can be touched safely."""
    herdr_do(["space.close", "--id", sid, "--confirmed", "true"])
    wanted = {(e["agent"], e["session"]) for e in links}
    deadline = time.time() + timeout
    while time.time() < deadline:
        try:
            gone = all(sp["id"] != sid for sp in herdr_ls())
            busy = any((r["agent"], r["session"]) in wanted for r in running_agents())
        except TetherError:
            return
        if gone and not busy:
            return
        time.sleep(0.25)
    say("the space is closed but an agent may still be shutting down")


def purge_session(agent, session):
    """Delete a session everywhere: the agent's own copy and the backup copy. Refuses a running one.
    -> {name, sessions, bytes}"""
    if agent not in AGENTS or not UUID_RE.match(session or ""):
        raise TetherError("not a valid session")
    if any(r["session"] == session and r["agent"] == agent for r in running_agents()):
        raise TetherError("that session is running; close it first")
    nbytes, found = 0, False
    for path in session_paths(agent, session):
        for root, _d, files in os.walk(path):
            nbytes += sum(os.path.getsize(os.path.join(root, f)) for f in files if not os.path.islink(os.path.join(root, f)))
        if os.path.isfile(path):
            nbytes += os.path.getsize(path)
        _remove(path)
        found = True
    name = None
    try:
        b = delete_backup_of_session(agent, session)
        nbytes, name, found = nbytes + b["bytes"], b["name"], True
    except TetherError:
        pass
    if not found:
        raise TetherError("there is nothing of that session to delete")
    return {"name": name or session[:8], "sessions": 1, "bytes": nbytes}


def delete_space(args):
    """Forget a space: unlink it from tether, and with --sessions also delete its sessions'
    transcripts. Never touches herdr (the herdr mod closes a live space itself)."""
    sessions = "--sessions" in args
    close = "--close" in args
    yes = "-y" in args or "--yes" in args
    sid, words, i = None, [], 0
    while i < len(args):
        if args[i] == "--id":
            if i + 1 >= len(args):
                sys.exit("usage: tether delete [space | --id <space-id>] [--sessions] [-y]")
            sid, i = args[i + 1], i + 2
            continue
        if args[i] not in ("--sessions", "--close", "-y", "--yes"):
            words.append(args[i])
        i += 1
    try:
        live = {sp["id"]: sp for sp in herdr_ls()}
    except TetherError:
        live = {}  # can't tell; stored names are used and nothing is closed here anyway
    with State() as st:
        data = {k: v for k, v in st.data.items() if v.get("terminals") or v.get("agents")}
    rows = space_rows(live, data)
    if sid is None:
        if words:
            sid = match_space(" ".join(words), rows)
            if sid is None:
                sys.exit(f"tether: no space matches {' '.join(words)!r}")
        else:
            sid = pick("delete which space?", [(row_label(n, l), i) for i, n, l, c in rows])
            if sid is None:
                return
    if sid not in data:
        sys.exit(f"tether: tether has nothing linked for space {sid!r}")
    sp = data[sid]
    name = (live[sid].get("name") if sid in live else None) or sp.get("name") or sid
    links = [e for _, _, _, e in all_links({sid: sp})]
    force = bool(env("FORCE"))
    print(f"space {name!r}" + ("  (still open in herdr)" if sid in live else "  (closed)"))
    for e in links:
        paths = session_paths(e["agent"], e["session"])
        running = _running(e, e["agent"])
        note = "RUNNING" if running else ("transcript found" if paths else "transcript already gone")
        print(f"  {e['agent']:<8} {e['session']}  [{note}]")
    if not yes:
        if not (sys.stdin.isatty() and sys.stdout.isatty()):
            sys.exit("tether: not a terminal; pass -y (and --sessions to delete transcripts)")
        if sessions:
            ask = input("unlink AND permanently delete these sessions' transcripts and their backup copies? type 'delete': ")
            if ask.strip().lower() != "delete":
                print("cancelled")
                return
        else:
            ask = input("[u]nlink (recoverable from the backup) / [d]elete everything permanently (transcripts and backups) / [N]o: ").strip().lower()
            if ask.startswith("d"):
                sessions = True
            elif not ask.startswith("u"):
                print("cancelled")
                return
    if close and sid in live:
        close_space_and_wait(sid, links)
    if not sessions:  # unlink only: keep a record, so `tether undelete` can bring it back
        try:
            with contextlib.redirect_stdout(io.StringIO()):
                backup_cmd(["--id", sid, "--quiet"])
        except (SystemExit, TetherError, OSError) as err:
            say(f"could not back up before unlinking ({err}); `tether undelete` may not find it")
    with State() as st:
        st.data.pop(sid, None)
        st.save()
    print(f"unlinked {name!r} from tether" + ("" if sessions else "  (undo: tether undelete)"))
    failed = 0
    if sessions:
        for e in links:
            if _running(e, e["agent"]) and not force:
                print(f"  kept {e['agent']} {e['session']}: still running (close it first)")
                failed += 1
                continue
            try:
                for path in session_paths(e["agent"], e["session"]):
                    _remove(path)
                try:
                    delete_backup_of_session(e["agent"], e["session"])  # permanent means the backup copy too
                except TetherError:
                    pass
                print(f"  deleted {e['agent']} session {e['session']}")
            except OSError as err:
                print(f"  could not delete {e['agent']} {e['session']}: {err}")
                failed += 1
    else:
        for e in links:
            if session_paths(e["agent"], e["session"]):
                print(f"  kept {e['agent']} session: {e['agent']} --resume {e['session']}")
    if failed:
        sys.exit(3)


# ---------- backup / restore / export / import ----------
# The agents keep conversations in their own folders and Claude sweeps old ones (30 days by default,
# and an admin can pin that). A backup folder laid out like each agent's home (claude/projects/...,
# copilot/session-state/...) lets a vanished transcript be put back, and a space be moved.

BACKUP_EVERY = 6 * 3600  # seconds between background backups


def config_path():
    return os.path.join(state_dir(), "config.json")


def load_config():
    try:
        with open(config_path()) as f:
            cfg = json.load(f)
        return cfg if isinstance(cfg, dict) else {}
    except (OSError, ValueError):
        return {}


def save_config(cfg):
    os.makedirs(state_dir(), exist_ok=True)
    tmp = config_path() + ".tmp"
    fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with os.fdopen(fd, "w") as f:
        json.dump(cfg, f, indent=2)
    os.replace(tmp, config_path())


DEFAULT_HOME_DIR = "~/.local/share/tether/home"


def home_dir_setting():
    """The folder new agents start in when you are in your home folder, created on first use.
    Not set in config.json: the default. Set to null (`--unset`): off, so None."""
    cfg = load_config()
    chosen = env("HOME_DIR") or (cfg["home_dir"] if "home_dir" in cfg else DEFAULT_HOME_DIR)
    if not chosen:
        return None
    path = os.path.abspath(os.path.expanduser(chosen))
    try:
        os.makedirs(path, exist_ok=True)
    except OSError:
        return None
    return path


def config_cmd(args):
    cfg = load_config()
    if not args:
        print(f"config file: {config_path()}")
        for key in ("backup_dir", "auto"):
            print(f"  {key:<11} {cfg.get(key, '(default)')}")
        print(f"  {'home_dir':<11} {home_dir_setting() or '(off)'}")
        return
    if args[0] != "home_dir" or len(args) > 2:
        sys.exit("usage: tether config [home_dir [path|--unset|--default]]")
    if len(args) == 1:
        print(home_dir_setting() or "(off)")
        return
    if args[1] in ("--unset", "unset"):
        cfg["home_dir"] = None
        save_config(cfg)
        print("home_dir is off: agents start in the folder you are in")
        return
    if args[1] == "--default":
        cfg.pop("home_dir", None)
        save_config(cfg)
        print(f"home_dir is back to the default: {os.path.expanduser(DEFAULT_HOME_DIR)}")
        return
    path = os.path.abspath(os.path.expanduser(args[1]))
    if not os.path.isdir(path):
        sys.exit(f"tether: {path} is not a folder")
    if os.path.realpath(path) == os.path.realpath(os.path.expanduser("~")):
        sys.exit("tether: pick a folder other than your home folder (that is the point)")
    cfg["home_dir"] = path
    save_config(cfg)
    print(f"new agents started from your home folder will start in {path}")


def backup_dir():
    chosen = env("BACKUP_DIR") or load_config().get("backup_dir") or "~/.local/share/tether/backups"
    return os.path.abspath(os.path.expanduser(chosen))


def live_home(agent):
    return _claude_home() if agent == "claude" else _copilot_home()


def session_files(agent, session, home=None):
    """[(absolute path, path relative to home)] for every regular file of one session under home."""
    home = home or live_home(agent)
    out = []
    for path in session_paths(agent, session, home):
        if os.path.islink(path):
            continue
        if os.path.isdir(path):
            for root, _dirs, files in os.walk(path):
                for name in files:
                    full = os.path.join(root, name)
                    if not os.path.islink(full):
                        out.append((full, os.path.relpath(full, home)))
        else:
            out.append((path, os.path.relpath(path, home)))
    return out


def _same_file(src, dst):
    try:
        a, b = os.stat(src), os.stat(dst)
    except OSError:
        return False
    return a.st_size == b.st_size and a.st_mtime_ns == b.st_mtime_ns


def copy_files(files, dst_home, overwrite=True):
    """Copy (src, rel) files under dst_home. Unchanged files are skipped; with overwrite=False an
    existing file is never replaced. Returns (copied, skipped, bytes copied)."""
    copied = skipped = nbytes = 0
    for src, rel in files:
        dst = os.path.join(dst_home, rel)
        if os.path.exists(dst) and (not overwrite or _same_file(src, dst)):
            skipped += 1
            continue
        os.makedirs(os.path.dirname(dst), mode=0o700, exist_ok=True)
        tmp = dst + ".tether-tmp"
        shutil.copy2(src, tmp)
        os.replace(tmp, dst)
        copied += 1
        nbytes += os.path.getsize(dst)
    return copied, skipped, nbytes


def ensure_not_committable(path):
    """Transcripts hold whatever you worked on. If the backup folder is inside a git repository, it
    must be git-ignored there, or one `git add .` would put conversations in a commit."""
    git = find_tool("git")
    if not git:
        return
    probe = path
    while not os.path.exists(probe) and os.path.dirname(probe) != probe:
        probe = os.path.dirname(probe)
    top = subprocess.run([git, "-C", probe, "rev-parse", "--show-toplevel"], capture_output=True, text=True)
    if top.returncode:
        return  # not in a repository
    os.makedirs(path, mode=0o700, exist_ok=True)
    ignored = subprocess.run([git, "-C", top.stdout.strip(), "check-ignore", "-q", os.path.join(path, "x")],
                             capture_output=True)
    if ignored.returncode:
        raise TetherError(f"{path} is inside the git repository {top.stdout.strip()} and is not git-ignored, so "
                          f"conversations could be committed. Add it to that repo's .gitignore, or set "
                          f"TETHER_BACKUP_DIR to a folder outside any repository.")


def prepare_backup_dir():
    dst = backup_dir()
    ensure_not_committable(dst)
    os.makedirs(dst, mode=0o700, exist_ok=True)
    os.chmod(dst, 0o700)
    return dst


def parse_opts(args, flags=(), valued=()):
    """(set of flags given, {option: value}, plain words). Unknown options are an error."""
    found, vals, words, i = set(), {}, [], 0
    while i < len(args):
        a = args[i]
        if a in flags:
            found.add(a)
            i += 1
        elif a in valued:
            if i + 1 >= len(args):
                sys.exit(f"tether: {a} needs a value")
            vals[a] = args[i + 1]
            i += 2
        elif a.startswith("-") and len(a) > 1:
            sys.exit(f"tether: unknown option {a}")
        else:
            words.append(a)
            i += 1
    return found, vals, words


def _selected_spaces(words, data, sid=None):
    """Spaces with links: the one with this exact id, else those whose stored name contains the
    words (all of them when no words)."""
    if sid:
        if sid not in data or not (data[sid].get("terminals") or data[sid].get("agents")):
            sys.exit(f"tether: no linked space with id {sid}")
        return {sid: data[sid]}
    needle = " ".join(words).strip().lower()
    return {k: sp for k, sp in data.items()
            if (sp.get("terminals") or sp.get("agents")) and needle in (sp.get("name") or k).lower()}


def source_session(e):
    """The session whose files hold this link's conversation. Normally its own; a fork nobody has typed
    in yet has no transcript of its own and is, for now, a copy of the session it was forked from."""
    own = e["session"]
    src = e.get("fork_of")
    if src and not session_exists(e["agent"], own) and not has_backup(e["agent"], own) \
            and (session_exists(e["agent"], src) or has_backup(e["agent"], src)):
        return src
    return own


def has_backup(agent, session):
    return bool(session_files(agent, session, os.path.join(backup_dir(), agent)))


def available(agent, session):
    """Can this session be resumed: the agent has it, or a backup can put it back."""
    return session_exists(agent, session) or has_backup(agent, session)


def link_summary(e, addr):
    return {"agent": e["agent"], "session": e["session"], "cwd": e.get("cwd"), "tab_name": e.get("tab_name") or "",
            "terminal": addr, "last_used": e.get("last_used"), **({"fork_of": e["fork_of"]} if e.get("fork_of") else {})}


def backup_status(data):
    """What the backup folder holds, and how it compares with the linked sessions (for `--status`)."""
    dst = backup_dir()
    cfg = load_config()
    flag = env("AUTO_BACKUP")
    auto = flag.lower() in ("1", "yes", "true", "on") if flag else bool(cfg.get("auto"))
    links = [e for sid in data for _, _, _, e in all_links({sid: data[sid]})]
    missing = [e for e in links if not session_exists(e["agent"], source_session(e))]
    size = 0
    for root, _dirs, files in os.walk(dst):
        for name in files:
            try:
                size += os.path.getsize(os.path.join(root, name))
            except OSError:
                pass
    last = None
    try:
        with open(os.path.join(dst, "manifest.json")) as f:
            stamps = [sp.get("backed_up") for sp in json.load(f).get("spaces", {}).values() if sp.get("backed_up")]
        last = max(stamps, default=None)
    except (OSError, ValueError):
        pass
    return {"dir": dst, "exists": os.path.isdir(dst), "auto": auto, "last_backup": last, "bytes": size,
            "linked": len(links), "backed_up": sum(1 for e in links if has_backup(e["agent"], source_session(e))),
            "missing": len(missing), "recoverable": sum(1 for e in missing if has_backup(e["agent"], source_session(e)))}


def _clean(text, limit=90):
    text = " ".join((text or "").split())
    return text if len(text) <= limit else text[: limit - 1].rstrip() + "…"


def session_title(agent, session):
    """What you first asked in a session, to tell sessions apart in a list ('' if unknown).
    Read from the agent's own copy, else from the backup. Only the start of the file is read."""
    for home in (None, os.path.join(backup_dir(), agent)):
        try:
            if agent == "claude":
                for path in session_paths("claude", session, home):
                    if not path.endswith(".jsonl"):
                        continue
                    with open(path, errors="replace") as f:
                        for _, line in zip(range(400), f):
                            try:
                                e = json.loads(line)
                            except ValueError:
                                continue
                            if e.get("type") != "user":
                                continue
                            c = (e.get("message") or {}).get("content")
                            if isinstance(c, list):
                                c = next((p.get("text") for p in c if isinstance(p, dict) and p.get("type") == "text"), "")
                            c = (c or "").strip()
                            if c and not c.startswith(("<", "Caveat:")):
                                return _clean(c)
            else:
                for path in session_paths("copilot", session, home):
                    events = os.path.join(path, "events.jsonl")
                    if not os.path.isfile(events):
                        continue
                    with open(events, errors="replace") as f:
                        for _, line in zip(range(400), f):
                            try:
                                e = json.loads(line)
                            except ValueError:
                                continue
                            if e.get("type") == "user.message":
                                c = ((e.get("data") or {}).get("content") or "").strip()
                                if c:
                                    return _clean(c)
        except OSError:
            continue
    return ""


def backup_list():
    """Every session the backup knows, newest first, with names a person can read."""
    try:
        with open(os.path.join(backup_dir(), "manifest.json")) as f:
            spaces = json.load(f).get("spaces", {})
    except (OSError, ValueError):
        spaces = {}
    try:
        live = {sp["id"]: sp.get("name") for sp in herdr_ls()}
    except TetherError:
        live = None
    with State() as st:
        data = dict(st.data)
    # linked under ANY space: a reopened space gets a new id, the manifest may still hold the old one
    linked = {e["session"] for _, _, _, e in all_links(data)}
    rows = []
    for sid, sp in spaces.items():
        for link in sp.get("links", []):
            agent, session = link.get("agent"), link.get("session")
            if agent not in AGENTS or not session:
                continue
            src = source_session(dict(link, agent=agent, session=session))  # an unused fork shows its source's files
            files = session_files(agent, src, os.path.join(backup_dir(), agent))
            in_agent = session_exists(agent, src)
            if not files and not in_agent:
                continue
            size = 0
            for full, _rel in files:
                try:
                    size += os.path.getsize(full)
                except OSError:
                    pass
            rows.append({
                "space_id": sid,
                "space": (live or {}).get(sid) or sp.get("name") or sid,
                "space_open": live is not None and sid in live,
                "tab": link.get("tab_name") or "",
                "agent": agent, "session": session, "cwd": link.get("cwd"),
                "last_used": link.get("last_used"), "backed_up": sp.get("backed_up"),
                "bytes": size, "title": session_title(agent, src),
                "in_agent": in_agent, "in_backup": bool(files), "linked": session in linked,
            })
    rows.sort(key=lambda r: (r["linked"], r.get("backed_up") or "", r.get("last_used") or ""), reverse=True)
    seen, unique = set(), []
    for r in rows:  # a session that moved between spaces appears once, under the space that has it now
        if (r["agent"], r["session"]) not in seen:
            seen.add((r["agent"], r["session"]))
            unique.append(r)
    unique.sort(key=lambda r: r.get("last_used") or "", reverse=True)
    return unique


def backup_cmd(args):
    flags, vals, words = parse_opts(args, flags=("--quiet", "--json", "--status", "--list", "--forget", "--everything"), valued=("--id", "--session", "--agent"))
    quiet = "--quiet" in flags
    if not ({"--status", "--list", "--forget"} & flags):
        safe_adopt()  # so tabs started without tether are backed up too
    if "--forget" in flags:
        if vals.get("--session"):  # one session's backup, whoever links it
            agent = vals.get("--agent") or next((a for a in AGENTS if has_backup(a, vals["--session"])
                                                  or session_exists(a, vals["--session"])), None)
            removed = (purge_session if "--everything" in flags else delete_backup_of_session)(agent, vals["--session"])
        elif not vals.get("--id"):
            sys.exit("usage: tether backup --forget --session <id> [--agent claude|copilot]  |  --forget --id <space-id>")
        else:
            removed = forget_backup(vals["--id"])
        print(json.dumps(removed) if "--json" in flags else
              f"removed {removed['sessions']} session(s) ({removed['bytes'] / 1e6:.1f} MB) of {removed['name']!r} from the backup")
        return
    if "--list" in flags:
        rows = backup_list()
        if "--json" in flags:
            print(json.dumps(rows))
            return
        if not rows:
            print("the backup holds no sessions yet; run `tether backup`")
        for r in rows:
            where = "on disk" if r["in_agent"] else "backup only (restore it)"
            print(f"{r['space']} / {r['tab'] or '-'}   {r['agent']}   {ago(r['last_used'])}   {r['bytes'] / 1e6:.1f} MB   [{where}]")
            print(f"    {r['title'] or '(no first message found)'}")
            print(f"    {r['agent']} --resume {r['session']}")
        return
    with State() as st:
        data = {k: v for k, v in st.data.items() if v.get("terminals") or v.get("agents")}
        if "--status" in flags:
            status = backup_status(data)
            if "--json" in flags:
                print(json.dumps(status))
            else:
                print(f"folder       {status['dir']}" + ("" if status["exists"] else "  (not created yet)"))
                print(f"automatic    {'on' if status['auto'] else 'off'}")
                print(f"last backup  {ago(status['last_backup']) if status['last_backup'] else 'never'}")
                print(f"size         {status['bytes'] / 1e6:.1f} MB")
                print(f"sessions     {status['backed_up']} of {status['linked']} linked sessions are backed up")
                print(f"missing      {status['missing']} linked transcript(s) gone, {status['recoverable']} recoverable "
                      f"from the backup")
            return
        chosen = _selected_spaces(words, st.data, vals.get("--id"))
    if not chosen:
        if "--json" in flags:
            print(json.dumps({"sessions": 0, "copied": 0, "skipped": 0, "bytes": 0, "empty": 0}))
        elif not quiet:
            print("nothing to back up: no matching linked spaces")
        return
    dst = prepare_backup_dir()
    copied = skipped = nbytes = sessions = empty = 0
    manifest_path = os.path.join(dst, "manifest.json")
    try:
        with open(manifest_path) as f:
            manifest = json.load(f)
    except (OSError, ValueError):
        manifest = {}
    manifest.setdefault("version", 1)
    spaces = manifest.setdefault("spaces", {})
    for sid, sp in chosen.items():
        links = []
        for _, _, addr, e in all_links({sid: sp}):
            files = session_files(e["agent"], source_session(e))
            if not files:
                empty += 1
            else:
                c, k, b = copy_files(files, os.path.join(dst, e["agent"]))
                copied, skipped, nbytes, sessions = copied + c, skipped + k, nbytes + b, sessions + 1
            links.append(link_summary(e, addr))
        spaces[sid] = {"name": sp.get("name") or sid, "links": links, "backed_up": now()}
    tmp = manifest_path + ".tmp"
    fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with os.fdopen(fd, "w") as f:
        json.dump(manifest, f, indent=2, sort_keys=True)
    os.replace(tmp, manifest_path)
    if "--json" in flags:
        print(json.dumps({"sessions": sessions, "copied": copied, "skipped": skipped, "bytes": nbytes,
                          "empty": empty, "dir": dst}))
    elif not quiet:
        print(f"backed up {sessions} session(s) to {dst}: {copied} file(s) new or changed "
              f"({nbytes / 1e6:.1f} MB), {skipped} unchanged" + (f"; {empty} had no transcript yet" if empty else ""))


def deleted_spaces():
    """Spaces the backup's manifest knows that tether no longer links, newest first."""
    try:
        with open(os.path.join(backup_dir(), "manifest.json")) as f:
            spaces = json.load(f).get("spaces", {})
    except (OSError, ValueError):
        return []
    with State() as st:
        data = st.data
    linked = {(e["agent"], e["session"]) for _, _, _, e in all_links(data)}
    rows = []
    for sid, sp in spaces.items():
        links = [l for l in sp.get("links", []) if l.get("agent") in AGENTS and UUID_RE.match(l.get("session", ""))]
        if sid in data or not links or all((l["agent"], l["session"]) in linked for l in links):
            continue
        rows.append({"id": sid, "name": sp.get("name") or sid, "backed_up": sp.get("backed_up") or "",
                     "links": [{"agent": l["agent"], "tab_name": l.get("tab_name") or "", "session": l["session"],
                                "transcript": session_exists(l["agent"], l["session"]),
                                "recoverable": has_backup(l["agent"], l["session"])} for l in links]})
    rows.sort(key=lambda r: r["backed_up"], reverse=True)
    return rows


def undelete_cmd(args):
    flags, vals, words = parse_opts(args, flags=("--list", "--json"), valued=("--id",))
    rows = deleted_spaces()
    if "--list" in flags:
        if "--json" in flags:
            print(json.dumps(rows))
        elif not rows:
            print("no deleted spaces in the backup")
        for r in rows:
            print(f"{r['name']:<32} {ago(r['backed_up'])}   ({len(r['links'])} session(s))")
        return
    if vals.get("--id"):
        pick_row = next((r for r in rows if r["id"] == vals["--id"]), None)
    elif words:
        q = " ".join(words).lower()
        hits = [r for r in rows if q in r["name"].lower()]
        exact = [r for r in hits if r["name"].lower() == q]
        hits = exact or hits
        pick_row = hits[0] if len(hits) == 1 else None
        if len(hits) > 1:
            sid = pick(f"{len(hits)} deleted spaces match {q!r}:",
                       [(f"{r['name']:<32} {ago(r['backed_up'])}", r["id"]) for r in hits])
            pick_row = next((r for r in hits if r["id"] == sid), None)
            if pick_row is None:
                return
    else:
        if not rows:
            sys.exit("tether: no deleted spaces in the backup")
        sid = pick("bring back which space?", [(f"{r['name']:<32} {ago(r['backed_up'])}", r["id"]) for r in rows])
        if sid is None:
            return
        pick_row = next(r for r in rows if r["id"] == sid)
    if pick_row is None:
        sys.exit("tether: no deleted space matches; `tether undelete --list` shows them")
    name, terms, restored = undelete_space(pick_row)
    if "--json" in flags:
        print(json.dumps({"id": pick_row["id"], "name": name, "sessions": len(terms), "restored": restored}))
    else:
        print(f"brought back {name!r} ({len(terms)} session(s)"
              + (f", {restored} transcript(s) restored from the backup" if restored else "")
              + "); it is a closed space: `tether open` it, or use the history button")


def undelete_space(pick_row):
    """Recreate a deleted space's links from the backup's record. -> (name, links, transcripts restored)"""
    with State() as st:
        if pick_row["id"] in st.data:
            raise TetherError("that space is already linked")
        existing = {norm_name(sp.get("name") or "") for sp in st.data.values()}
        name = pick_row["name"]
        if norm_name(name) in existing:
            name = f"{name} (restored)"
        terms = {}
        with open(os.path.join(backup_dir(), "manifest.json")) as f:
            stored = json.load(f)["spaces"][pick_row["id"]]["links"]
        for i, l in enumerate(stored):
            if l.get("agent") not in AGENTS or not UUID_RE.match(l.get("session", "")):
                continue
            addr = l.get("terminal") or f"t-restored{i}"
            terms[addr] = {"agent": l["agent"], "session": l["session"], "cwd": l.get("cwd") or os.path.expanduser("~"),
                           "tab": "", "tab_name": l.get("tab_name") or "", "created": l.get("last_used") or now(),
                           "last_used": l.get("last_used") or now()}
        st.data[pick_row["id"]] = {"name": name, "terminals": terms, "agents": {}}
        st.save()
    restored = sum(1 for e in terms.values() if not session_exists(e["agent"], e["session"])
                   and restore_session(e["agent"], e["session"]))
    return name, terms, restored


def delete_backup_of_session(agent, session):
    """Delete ONE session's backup: its copies in the backup folder and its record in the manifest.
    Allowed for any session, linked or not (the next `tether backup` copies a linked one again); never
    touches the agent's own files. -> {name, sessions, bytes}"""
    if agent not in AGENTS or not UUID_RE.match(session or ""):
        raise TetherError("not a valid session")
    home = os.path.join(backup_dir(), agent)
    nbytes = removed = 0
    for path in session_paths(agent, session, home):
        for root, _d, files in os.walk(path):
            nbytes += sum(os.path.getsize(os.path.join(root, f)) for f in files if not os.path.islink(os.path.join(root, f)))
        if os.path.isfile(path):
            nbytes += os.path.getsize(path)
        _remove(path)
        removed = 1
        parent = os.path.dirname(path)
        while os.path.realpath(parent).startswith(os.path.realpath(home) + os.sep):
            try:
                os.rmdir(parent)
            except OSError:
                break
            parent = os.path.dirname(parent)
    manifest_path = os.path.join(backup_dir(), "manifest.json")
    name = None
    try:
        with open(manifest_path) as f:
            manifest = json.load(f)
    except (OSError, ValueError):
        manifest = None
    if manifest:
        for sid in list(manifest.get("spaces", {})):
            sp = manifest["spaces"][sid]
            keep = [l for l in sp.get("links", []) if not (l.get("agent") == agent and l.get("session") == session)]
            if len(keep) != len(sp.get("links", [])):
                name = name or sp.get("name")
                removed = removed or 1
                if keep:
                    sp["links"] = keep
                else:
                    del manifest["spaces"][sid]
        tmp = manifest_path + ".tmp"
        fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
        with os.fdopen(fd, "w") as f:
            json.dump(manifest, f, indent=2, sort_keys=True)
        os.replace(tmp, manifest_path)
    if not removed:
        raise TetherError("the backup has no copy of that session")
    return {"name": name or session[:8], "sessions": 1, "bytes": nbytes}


def forget_backup(sid, only_session=None):
    """Remove a DELETED space from the backup: its manifest entry and the backed-up copies of its
    sessions (unless another space still uses them). only_session: remove just that one session. Never touches the agents' own transcripts, and
    refuses a space tether still links."""
    with State() as st:
        if sid in st.data:
            raise TetherError("that space is still linked; delete it first, then remove its backup")
        linked = {(e["agent"], e["session"]) for _, _, _, e in all_links(st.data)}
    manifest_path = os.path.join(backup_dir(), "manifest.json")
    try:
        with open(manifest_path) as f:
            manifest = json.load(f)
        space = manifest["spaces"][sid]
    except (OSError, ValueError, KeyError):
        raise TetherError("the backup has no record of that space")
    others = {(l["agent"], l["session"]) for k, sp in manifest["spaces"].items() if k != sid
              for l in sp.get("links", []) if l.get("agent") in AGENTS and l.get("session")}
    removed = nbytes = 0
    kept_links = []
    for l in space.get("links", []):
        key = (l.get("agent"), l.get("session"))
        if only_session and key[1] != only_session:
            kept_links.append(l)
            continue
        if key[0] not in AGENTS or key in linked or key in others:
            continue
        home = os.path.join(backup_dir(), key[0])
        for path in session_paths(key[0], key[1], home):
            for root, _d, files in os.walk(path):
                nbytes += sum(os.path.getsize(os.path.join(root, f)) for f in files if not os.path.islink(os.path.join(root, f)))
            if os.path.isfile(path):
                nbytes += os.path.getsize(path)
            _remove(path)
            parent = os.path.dirname(path)
            while os.path.realpath(parent).startswith(os.path.realpath(home) + os.sep):
                try:
                    os.rmdir(parent)
                except OSError:
                    break
                parent = os.path.dirname(parent)
        removed += 1
    if only_session and kept_links:
        manifest["spaces"][sid]["links"] = kept_links
    else:
        del manifest["spaces"][sid]
    tmp = manifest_path + ".tmp"
    fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with os.fdopen(fd, "w") as f:
        json.dump(manifest, f, indent=2, sort_keys=True)
    os.replace(tmp, manifest_path)
    return {"id": sid, "name": space.get("name") or sid, "sessions": removed, "bytes": nbytes}


def restore_session(agent, session):
    """Put a session's transcript back from the backup if the agent no longer has it. Never
    overwrites a file the agent has. Returns how many files were restored."""
    files = session_files(agent, session, os.path.join(backup_dir(), agent))
    if not files:
        return 0
    return copy_files(files, live_home(agent), overwrite=False)[0]


def restore_cmd(args):
    _, vals, words = parse_opts(args, valued=("--id", "--session", "--agent"))
    if vals.get("--session"):  # one session by its id, whether or not any space still links it
        session = vals["--session"]
        agent = vals.get("--agent")
        if agent not in AGENTS:
            agent = next((a for a in AGENTS if has_backup(a, session)), None)
        if agent is None or not UUID_RE.match(session):
            sys.exit(f"tether: no backup of session {session!r}")
        if session_exists(agent, session):
            print(f"{agent} already has session {session}; nothing to restore")
            return
        n = restore_session(agent, session)
        if not n:
            sys.exit(f"tether: no copy of {agent} session {session} in the backup")
        print(f"restored {agent} session {session} ({n} file(s)); resume it with: {agent} --resume {session}")
        return
    with State() as st:
        chosen = _selected_spaces(words, st.data, vals.get("--id"))
    total = missing = 0
    for sid, sp in chosen.items():
        for _, _, _, e in all_links({sid: sp}):
            src = source_session(e)
            if session_exists(e["agent"], src):
                continue
            missing += 1
            n = restore_session(e["agent"], src)
            total += bool(n)
            print(f"  {sp.get('name') or sid}: {e['agent']} {e['session'][:8]}  "
                  + (f"restored ({n} file(s))" if n else "no copy in the backup"))
    print(f"{total} of {missing} missing transcript(s) restored" if missing else "no transcript is missing")


def auto_backup_if_due():
    """Start `tether backup` in the background, at most every BACKUP_EVERY seconds, if enabled."""
    flag = env("AUTO_BACKUP")
    on = flag.lower() in ("1", "yes", "true", "on") if flag else bool(load_config().get("auto"))
    if not on:
        return
    stamp = os.path.join(state_dir(), "last-backup")
    try:
        if time.time() - os.path.getmtime(stamp) < BACKUP_EVERY:
            return
    except OSError:
        pass
    try:
        open(stamp, "w").close()
        subprocess.Popen([sys.executable, os.path.realpath(sys.argv[0]), "backup", "--quiet"],
                         stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                         start_new_session=True)
    except OSError:
        pass


def _slug(name):
    return re.sub(r"[^A-Za-z0-9]+", "-", name).strip("-").lower() or "space"


def unique_path(path):
    """path, or path with -2, -3 ... before the extension if that file already exists."""
    if not os.path.exists(path):
        return path
    stem, ext = (path[:-len(".tar.gz")], ".tar.gz") if path.endswith(".tar.gz") else os.path.splitext(path)
    n = 2
    while os.path.exists(f"{stem}-{n}{ext}"):
        n += 1
    return f"{stem}-{n}{ext}"


def export_space(args):
    flags, vals, words = parse_opts(args, flags=("--json",), valued=("-o", "--output", "--id"))
    out = vals.get("-o") or vals.get("--output")
    if not words and "--id" not in vals:
        sys.exit("usage: tether export <space> | --id <space-id> [-o file.tar.gz | folder] [--json]")
    try:
        live = {sp["id"]: sp for sp in herdr_ls()}
    except TetherError:
        live = {}
    with State() as st:
        data = {k: v for k, v in st.data.items() if v.get("terminals") or v.get("agents")}
    if "--id" in vals:
        sid = vals["--id"] if vals["--id"] in data else None
    else:
        sid = match_space(" ".join(words), space_rows(live, data))
    if sid is None:
        sys.exit(f"tether: no space matches {' '.join(words) or vals.get('--id')!r}")
    sp = data[sid]
    name = (live[sid].get("name") if sid in live else None) or sp.get("name") or sid
    default = f"tether-export-{_slug(name)}-{datetime.now().strftime('%Y%m%d')}.tar.gz"
    if out and os.path.isdir(out):
        out = os.path.join(out, default)  # a folder: name the file for the space
    out = unique_path(out or default)
    links = [(addr, e) for _, _, addr, e in all_links({sid: sp})]
    manifest = {"version": 1, "exported": now(), "space": {"name": name, "links": [
        link_summary(e, addr) for addr, e in links]}}
    members, missing = [], 0
    for _, e in links:
        files = session_files(e["agent"], e["session"])
        if not files:  # the agent has swept it: fall back to the backup
            files = session_files(e["agent"], e["session"], os.path.join(backup_dir(), e["agent"]))
        if not files:
            missing += 1
        members += [(path, f"files/{e['agent']}/{rel}") for path, rel in files]
    fd = os.open(out, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
    with os.fdopen(fd, "wb") as raw, tarfile.open(fileobj=raw, mode="w:gz") as tar:
        blob = json.dumps(manifest, indent=2).encode()
        info = tarfile.TarInfo("manifest.json")
        info.size, info.mtime, info.mode = len(blob), time.time(), 0o600
        tar.addfile(info, io.BytesIO(blob))
        for path, arc in members:
            tar.add(path, arcname=arc, recursive=False)
    if "--json" in flags:
        print(json.dumps({"path": os.path.abspath(out), "name": name, "sessions": len(links),
                          "files": len(members), "missing": missing}))
        return
    print(f"exported {name!r}: {len(links)} session(s), {len(members)} file(s) -> {out}"
          + (f"  ({missing} had no transcript anywhere)" if missing else ""))
    print("  this file holds the full conversations (0600). Keep it private; import it with `tether import`.")


def _member_session(parts):
    """The session uuid a `files/<agent>/...` path belongs to, or None if it is not session data."""
    agent, rel = parts[1], parts[2:]
    if agent == "claude":
        if rel[0] == "projects" and len(rel) == 3 and rel[2].endswith(".jsonl"):
            return rel[2][:-len(".jsonl")]
        if rel[0] == "projects" and len(rel) > 3:
            return rel[2]
        if rel[0] in ("file-history", "session-env") and len(rel) >= 3:
            return rel[1]
    elif rel[0] == "session-state" and len(rel) >= 3:
        return rel[1]
    return None


def import_space(args):
    flags, vals, words = parse_opts(args, flags=("--json",), valued=("--name",))
    name_override = vals.get("--name")
    if len(words) != 1:
        sys.exit("usage: tether import <file.tar.gz> [--name NAME] [--json]")
    try:
        tar = tarfile.open(words[0], "r:gz")
    except (OSError, tarfile.TarError) as err:
        sys.exit(f"tether: cannot read {words[0]}: {err}")
    with tar:
        try:
            manifest = json.load(tar.extractfile("manifest.json"))
            links = manifest["space"]["links"]
            for lk in links:
                if lk["agent"] not in AGENTS or not UUID_RE.match(lk["session"]):
                    raise ValueError("bad link")
        except (KeyError, ValueError, TypeError, AttributeError):
            sys.exit("tether: not a tether export (missing or invalid manifest.json)")
        wanted = {lk["session"] for lk in links}
        todo = []
        for m in tar.getmembers():
            if m.name == "manifest.json" or m.isdir():
                continue
            parts = m.name.split("/")
            bad = (not m.isfile() or m.name.startswith("/") or ".." in parts or "" in parts or "\x00" in m.name
                   or len(parts) < 4 or parts[0] != "files" or parts[1] not in AGENTS
                   or _member_session(parts) not in wanted)
            if bad:
                sys.exit(f"tether: refusing to import: unexpected entry {m.name!r} in the bundle")
            todo.append(m)
        restored = skipped = 0
        for m in todo:
            parts = m.name.split("/")
            dst = os.path.join(live_home(parts[1]), *parts[2:])
            if os.path.exists(dst):  # never replace a conversation this machine already has
                skipped += 1
                continue
            os.makedirs(os.path.dirname(dst), mode=0o700, exist_ok=True)
            tmp = dst + ".tether-tmp"
            with tar.extractfile(m) as src, open(tmp, "wb") as out:
                shutil.copyfileobj(src, out)
            os.chmod(tmp, 0o600)
            os.replace(tmp, dst)
            restored += 1
    try:
        taken = {norm_name(sp.get("name") or "") for sp in herdr_ls()}
    except TetherError:
        taken = set()
    with State() as st:
        taken |= {norm_name(sp.get("name") or "") for sp in st.data.values()}
        name = name_override or manifest["space"].get("name") or "imported"
        base, n = name, 1
        while norm_name(name) in taken:
            n += 1
            name = f"{base} (imported{'' if n == 2 else ' ' + str(n - 1)})"
        sid = "imported-" + uuid4().hex[:12]
        stamp = now()
        terms = {}
        for k, lk in enumerate(links):
            terms[lk.get("terminal") or f"x{k}"] = {
                "agent": lk["agent"], "session": lk["session"], "cwd": lk.get("cwd") or "", "tab": "",
                "tab_name": lk.get("tab_name") or "", "created": stamp, "last_used": stamp}
        st.data[sid] = {"name": name, "terminals": terms, "agents": {}, "accessed": stamp}
        st.save()
    if "--json" in flags:
        print(json.dumps({"id": sid, "name": name, "sessions": len(links), "files": restored, "skipped": skipped}))
        return
    print(f"imported {name!r}: {len(links)} session(s), {restored} file(s) written, {skipped} already here")
    print(f"  it is a closed space now; restore it with: tether open {name!r}")


def open_by_name_or_fail(word):
    try:
        ensure_app()
        live = {s["id"]: s for s in herdr_ls()}
        with State() as st:
            data = {k: v for k, v in st.data.items() if v.get("terminals") or v.get("agents")}
        rows = space_rows(live, data)
        sid = match_space(word, rows) if rows else None
        if sid is not None:
            return open_space(None, False, sid=sid)
    except TetherError:
        pass
    sys.exit(f"tether: unknown command or space {word!r} (try `tether --help`)")


def tether_cmd():
    """What to type into a shell to run this script."""
    return "tether" if shutil.which("tether") else f"'{os.path.realpath(sys.argv[0])}'"


def norm_name(s):
    return " ".join(s.split()).lower()


def name_problem(name):
    """Why this can't be a new space's name (same rule as the herdr "+" dialog), else None.
    Open and closed spaces both count: reopening a closed one by its name would be ambiguous."""
    n = norm_name(name)
    live = herdr_ls()
    if any(norm_name(sp.get("name") or "") == n for sp in live):
        return f"A space named {name.strip()!r} is already open."
    ids = {sp["id"] for sp in live}
    with State() as st:
        for sid, sp in st.data.items():
            if sid not in ids and (sp.get("terminals") or sp.get("agents")) \
                    and norm_name(sp.get("name") or "") == n:
                return (f"A closed space named {name.strip()!r} exists. Reopen it from the "
                        f"menu (`tether`), or pick another name.")
    return None


def new_space():
    """Make a herdr space (asks for a name and an agent) and start the agent in it."""
    app = find_tool("herdr-app")
    hc = find_tool("hc")
    if not (app and hc):
        raise TetherError("herdr-app and hc must be on PATH")
    ensure_app()
    while True:
        try:
            name = input("name for the new space (empty to cancel): ").strip()
        except EOFError:
            return
        if not name:
            print("cancelled")
            return
        problem = name_problem(name)
        if not problem:
            break
        print(f"  {problem}")
    agent = pick("start which agent?", [("claude", "claude"), ("copilot", "copilot")])
    if not agent:
        print("cancelled")
        return
    r = subprocess.run([app, "do", "space.new", "--name", name, "--folder", os.getcwd()],
                       capture_output=True, text=True, timeout=15)
    try:
        made = json.loads(r.stdout)
    except ValueError:
        made = {"error": (r.stderr or r.stdout).strip()[:200]}
    if r.returncode or "error" in made or not made.get("terminal"):
        raise TetherError(f"could not create the space: {made.get('error', 'no terminal returned')}")
    send = subprocess.run([hc, "send", made["terminal"], f"{tether_cmd()} {agent}"],
                          capture_output=True, text=True)
    if send.returncode:
        raise TetherError(f"space {name!r} created, but could not start {agent} in "
                          f"{made['terminal']}: {(send.stderr or send.stdout).strip()[:200]}")
    print(f"created space {name!r}; started {agent} in {made['terminal']}")


def menu():
    """Bare `tether`: resume this terminal's link if it has one, else an arrow-key menu."""
    if not (sys.stdin.isatty() and sys.stdout.isatty()):
        print(__doc__)
        return
    where = None
    if os.environ.get("HC_TERMINAL_ID"):
        where, _ = resolve_where()
    if where is not None:
        with State() as st:
            has = where.terminal in st.data.get(where.space_id, {}).get("terminals", {})
        if has:  # outside the `with`: resume_here takes the same lock
            return resume_here()
    items = []
    if where is not None:
        items += [("claude   start in this terminal", ("here", "claude"), True),
                  ("copilot  start in this terminal", ("here", "copilot"), True)]
    items.append(("+ new space...", ("new", None), True))
    if where is None:
        ensure_app()
    live = {s["id"]: s for s in herdr_ls()}
    with State() as st:
        data = dict(st.data)
    for sid, name, last, closed in space_rows(live, data, openable_only=True):
        items.append((row_label(name, last), ("space", sid)))
    choice = pick("tether:", items)
    if not choice:
        return
    kind, val = choice
    if kind == "here":
        launch(val, [])
    elif kind == "new":
        new_space()
    else:
        open_space(None, False, sid=val)


# ---------- reading another conversation (used by `tether read`) ----------

EXTRACT_CAP = 60_000  # characters of one conversation returned at most (start and end kept)


def conversation_text(agent, path, cap=EXTRACT_CAP, as_lines=False):
    """-> (text, turns, commands). What a conversation said (USER / ASSISTANT lines) and the shell commands the agent ran
    (COMMAND lines, each cut short, repeats left out). Command OUTPUT is never read: it can hold customer data."""
    lines, seen, turns, cmds = [], set(), 0, 0
    try:
        with open(path, errors="replace") as f:
            for raw in f:
                try:
                    e = json.loads(raw)
                except ValueError:
                    continue
                t, said, cmd = e.get("type"), None, None
                if agent == "claude":
                    if t in ("user", "assistant") and not e.get("isMeta"):
                        c = (e.get("message") or {}).get("content")
                        if isinstance(c, list):
                            for part in c:
                                if isinstance(part, dict) and part.get("type") == "tool_use" and part.get("name") == "Bash":
                                    cmd = (part.get("input") or {}).get("command")
                            c = " ".join(x.get("text", "") for x in c if isinstance(x, dict) and x.get("type") == "text")
                        said = (t.upper(), c)
                else:
                    d = e.get("data") or {}
                    if t in ("user.message", "assistant.message"):
                        said = ("USER" if t == "user.message" else "ASSISTANT", d.get("content"))
                    elif t == "tool.execution_start" and d.get("toolName") in (None, "bash"):
                        a = d.get("arguments") or d.get("input") or {}
                        cmd = a.get("command") if isinstance(a, dict) else None
                if said and isinstance(said[1], str) and said[1].strip() and not said[1].strip().startswith(("<", "Caveat:")):
                    lines.append(f"{said[0]}: {said[1].strip()}")
                    turns += 1
                if isinstance(cmd, str) and cmd.strip() and cmd.strip() not in seen:
                    seen.add(cmd.strip())
                    lines.append("COMMAND: " + cmd.strip()[:700])
                    cmds += 1
    except OSError:
        pass
    if as_lines:
        return lines
    text = "\n".join(lines)
    if len(text) > cap:
        text = text[:cap // 2] + "\n[... middle left out ...]\n" + text[-cap // 2:]
    return text, turns, cmds


def find_conversations(words, space_id, session):
    """The conversations of a space (by id or name) or one session, from the agent's own files or the backup."""
    docs = [d for d in search_corpus(["open", "closed", "deleted"]) if d.get("path")]
    if session:
        hit = [d for d in docs if d["session"].startswith(session)]
    elif space_id:
        hit = [d for d in docs if d["space_id"] == space_id]
    else:
        needle = " ".join(words).strip().lower()
        if not needle:
            sys.exit("usage: tether read <space name> [--id <space-id> | --session <id>] [--last N]")
        exact = {d["space_id"] for d in docs if d["space"].lower() == needle}
        ids = exact or {d["space_id"] for d in docs if needle in d["space"].lower()}
        if len(ids) > 1:
            raise TetherError("more than one space matches: " + ", ".join(sorted({d["space"] for d in docs if d["space_id"] in ids})))
        hit = [d for d in docs if d["space_id"] in ids]
    if not hit:
        raise TetherError("no conversation found there (a space nobody has typed in has none)")
    return hit


def main(argv):
    if not argv:
        return menu()
    cmd, rest = argv[0], argv[1:]
    if cmd in ("-h", "--help", "help"):
        print(__doc__)
    elif cmd in ("--version", "-V", "version"):
        print(f"tether {__version__}")
    elif cmd in AGENTS:
        launch(cmd, rest)
    elif cmd == "resume":
        resume_here()
    elif cmd == "link":
        if not rest or rest[0] not in AGENTS or len(rest) > 2:
            sys.exit("usage: tether link claude|copilot [session-id]")
        link(rest[0], rest[1] if len(rest) == 2 else None)
    elif cmd == "status":
        status()
    elif cmd == "list":
        list_all(rest)
    elif cmd == "touch":
        if len(rest) != 1:
            sys.exit("usage: tether touch <space-id>")
        touch(rest[0])
    elif cmd == "open":
        yes = "-y" in rest or "--yes" in rest
        words = [a for a in rest if a not in ("-y", "--yes")]
        if "--id" in words:  # exact space id: no name matching, no menu (used by the herdr mod)
            i = words.index("--id")
            if i + 1 >= len(words):
                sys.exit("usage: tether open --id <space-id> [-y]")
            sid = words[i + 1]
            with State() as st:
                if sid not in st.data:
                    sys.exit(f"tether: no linked space with id {sid}")
            open_space(None, yes, sid=sid)
        else:
            open_space(" ".join(words), yes)
    elif cmd == "delete":
        delete_space(rest)
    elif cmd == "search":
        search_cmd(rest)
    elif cmd == "read":
        read_cmd(rest)
    elif cmd == "adopt":
        adopt_cmd(rest)
    elif cmd == "fork":
        fork_space(rest)
    elif cmd == "undelete":
        undelete_cmd(rest)
    elif cmd == "open-session":
        open_session(rest)
    elif cmd == "doctor":
        doctor_cmd(rest)
    elif cmd == "config":
        config_cmd(rest)
    elif cmd == "backup":
        backup_cmd(rest)
    elif cmd == "restore":
        restore_cmd(rest)
    elif cmd == "export":
        export_space(rest)
    elif cmd == "import":
        import_space(rest)
    elif cmd == "reset":
        if rest and rest[0] not in AGENTS:
            sys.exit("usage: tether reset [claude|copilot]")
        reset(rest[0] if rest else None)
    else:
        open_by_name_or_fail(" ".join(argv))


if __name__ == "__main__":
    try:
        main(sys.argv[1:])
    except TetherError as e:
        sys.exit(f"tether: {e}")
    except KeyboardInterrupt:
        sys.exit(130)
