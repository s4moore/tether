#!/usr/bin/env python3
"""tether: persistent Claude / Copilot sessions for Herdr spaces. `tether --help` lists everything.

This file is only the entry point. The code is the `tetherlib` package in ../lib (installed to ~/.local/lib/tetherlib
next to ~/.local/bin/tether); start with tetherlib/cli.py.
"""
import os
import sys

sys.path.insert(0, os.path.join(os.path.dirname(os.path.realpath(__file__)), "..", "lib"))

from tetherlib.cli import run  # noqa: E402

run()
